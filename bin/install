#!/usr/bin/env python3
"""Install Partitur for Claude Code, Codex, or both, for a user or a project.

Usage:
  install [--tool {auto,claude,codex,all}] --scope user [--uninstall]
  install [--tool {auto,claude,codex,all}] --scope project [PROJECT]
          [--update | --uninstall] [--force [--backup-to PATH]] [--merge-rules]
          [--name NAME] [--records DIR] [--branch MAIN]
          [--repo NAME:CHECKOUT:MAIN ...] [--add-repo NAME:CHECKOUT:MAIN ...]

--scope user
  Links this repository as the skill `partitur` in the user's skill
  directories: ~/.claude/skills (Claude Code) and ~/.agents/skills (Codex).
  Every session of this user can then find Partitur in any project.
  Command templates are named SKILL.md.in; only their installed SKILL.md
  files are discoverable as command skills.

--scope project
  Sets PROJECT (default: the current directory, the workspace root that
  holds the code checkouts) up to work the Partitur way:
    <records>/                Git repository (main branch --branch, default master)
    <records>/CLAUDE.md       the rules file, from templates/rules.md
    <records>/pr/             request directories, repos table, README
    <records>/handoff/        integrator.md (the integrator's status), notes/
                              (temporary notes to the designer)
    <records>/tasks/          tasks: open/, done/, cancelled/, charter template;
                              open/T0000-design/, the root design task whose
                              holder is the designer
    <records>/roles/          integrator/ role records
    <records>/bin/            ptt, pr, and test-run, from project/bin/
    <records>/skills/         the ptt-* skills
  and, for each chosen tool, the links it reads in the workspace root:
    Claude Code:  CLAUDE.md -> <records>/CLAUDE.md, .claude/skills/<skill>, and in
                  .claude/settings.json a prompt hook running `ptt inbox --quiet`
                  (it prints only when the records hold something new for the
                  session's holder); other settings there are kept
    Codex:        AGENTS.md -> <records>/CLAUDE.md, .agents/skills/<skill>, and
                  .codex/hooks.json running `ptt inbox --quiet --hook`
                  (review and trust it in Codex before it runs)
  where <skill> is each ptt-* skill, and the `partitur` entry skill
  unless the user scope already links it for that tool.
  The name defaults to the directory's name and <records> to `workspace`.
  The repository table (<records>/pr/repos) starts with every Git checkout
  directly in PROJECT (name = directory, main branch = its checked-out
  branch), except the records repository and Partitur itself. --repo sets it
  to exactly the repositories given (the old table is backed up);
  --add-repo adds to it, for example a checkout deeper down. Install warns
  about any repository that existing requests name but the table lacks.

  The rules file holds Partitur's rules as a block between
  "<!-- partitur rules begin" and "<!-- partitur rules end -->"; the project's
  own rules go outside it. An existing rules file without the block is left
  alone and reported "not merged"; --merge-rules adds the block after the
  file's title. Before that, ask the agent to compare both rule sets and list
  every contradiction for the user to decide.

--tool auto (the default) installs for the agent tools found on this machine:
Claude Code if the `claude` command or ~/.claude exists, Codex if the `codex`
command or ~/.codex exists. It reports what it found, and stops if it finds
neither; --tool claude, codex, or all chooses explicitly.

A project records which Partitur commit installed it, in one line of
<records>/.partitur-version. Git already knows what Partitur ships, so
install rebuilds from that commit what it delivered then: "maintained" files
(tools, skills, pr/README.md, the charter template), "seeded" files (the
rules file, the root design task's charter and status, the integrator's
file, repository table, directory markers: the project's once created), and
links. A seeded file an earlier Partitur used but this one no longer does is
reported "superseded", with where its content goes; it is never removed.
Compared with the project:
  install            creates what is missing and reports the rest: "kept",
                     "outdated" (unchanged here, but this Partitur has a
                     newer version), "modified" (changed here), "obsolete"
                     (delivered then, no longer shipped).
  --update           also replaces outdated files and removes obsolete ones,
                     then stamps the current commit.
  --uninstall        removes every maintained file and link still as
                     delivered; keeps seeded files, files changed here, and
                     every record (tasks, requests, roles).
  --force            with --update or --uninstall: also replaces or removes
                     files changed here, after copying each into a backup
                     directory (PROJECT/partitur-backup-<UTC time>/, or
                     --backup-to PATH).
Install from a committed Partitur: with uncommitted changes there is no
commit to stamp, and a later update cannot find what was dropped.
Nothing is ever committed; the tool prints the `ptt record` command for it.
Each project run except --uninstall also writes PROJECT/partitur-install-report.md:
its output and the next steps, for an agent session to read ("Read
partitur-install-report.md and help me finish the Partitur install"). It
lies outside the records repository, is never committed, and is
overwritten by the next run.
The user scope is one link per tool, which --uninstall removes if it still
points to this Partitur. Without --scope, nothing is changed and this text
is printed.
"""
import argparse
import atexit
import fcntl
from datetime import datetime, timezone
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
URL = "https://github.com/QiaoLei-88/Partitur"
TOOLS = {"claude": ("CLAUDE.md", ".claude"), "codex": ("AGENTS.md", ".agents")}


class Report:
    def __init__(self, base):
        self.base, self.counts, self.paths = base, {}, []

    def __call__(self, kind, path, note=""):
        self.counts[kind] = self.counts.get(kind, 0) + 1
        self.paths.append((kind, os.path.relpath(path, self.base)))
        print(f"{kind:10} {os.path.relpath(path, self.base)}" + (f"  ({note})" if note else ""))


def sha(data):
    return hashlib.sha256(data if isinstance(data, bytes) else data.encode()).hexdigest()


def file_sha(path):
    return sha(path.read_bytes()) if path.is_file() and not path.is_symlink() else None


def partitur_commit():
    """The Partitur commit being installed, or None for uncommitted changes."""
    r = subprocess.run(["git", "-C", str(HERE), "status", "--porcelain", "--untracked-files=no",
                        "--", "bin", "project", "templates"], capture_output=True, text=True)
    if r.returncode or r.stdout.strip():
        return None
    r = subprocess.run(["git", "-C", str(HERE), "rev-parse", "HEAD"], capture_output=True,
                       text=True)
    return r.stdout.strip() or None


class Source:
    """Partitur's files, from the working tree or from a past commit."""

    def __init__(self, commit=None):
        self.commit = commit

    def read(self, rel):
        if self.commit is None:
            return (HERE / rel).read_bytes()
        return subprocess.run(["git", "-C", str(HERE), "show", f"{self.commit}:{rel}"],
                              capture_output=True, check=True).stdout

    def has(self, rel):
        if self.commit is None:
            return (HERE / rel).exists()
        return subprocess.run(["git", "-C", str(HERE), "cat-file", "-e", f"{self.commit}:{rel}"],
                              capture_output=True).returncode == 0

    def names(self, rel):
        if self.commit is None:
            return sorted(p.name for p in (HERE / rel).iterdir())
        out = subprocess.run(["git", "-C", str(HERE), "ls-tree", "--name-only",
                              f"{self.commit}:{rel}"], capture_output=True, text=True,
                             check=True).stdout
        return sorted(out.split())


def known_commit(commit):
    return commit and subprocess.run(["git", "-C", str(HERE), "cat-file", "-e",
                                      f"{commit}^{{commit}}"], capture_output=True).returncode == 0


def delivered(plan):
    """A plan as the entries install compares against: kind, content hash, target."""
    out = {}
    for rel, e in plan.items():
        if e["kind"] == "rules":
            digest = sha(block_of(e["data"].decode()) or "")
        else:
            digest = sha(e["data"]) if "data" in e else None
        out[rel] = dict(kind=e["kind"], target=e.get("target"), sha=digest)
    return out


SUPERSEDED = {
    "handoff/designer.md": "the root designer is now the holder of task T0000: move this "
    "file's role and read-first parts into tasks/open/T0000-design/charter.md and its state "
    "and next steps into status.md there, then delete it",
    "roles/designer/.gitkeep": "designers' takes are now events of task T0000; move earlier "
    "role records out of roles/designer/ (ptt refuses while it holds events), then delete it",
}

BEGIN = "<!-- partitur rules begin"
END = "<!-- partitur rules end -->"
AGENT_HINT = ("Ask the agent to compare Partitur's rules block with the project's own rules: "
              "it removes duplicates, keeps domain rules, and asks you only about real "
              "conflicts and about adopting the block.")


def block_of(text):
    """Partitur's rules block in a rules file, markers included, or None."""
    i = text.find(BEGIN)
    j = text.find(END, i + 1) if i >= 0 else -1
    return text[i:j + len(END)] if i >= 0 and j >= 0 else None


def merge_block(text, block):
    """Insert the block after the file's title and first paragraph."""
    lines = text.split("\n")
    k = 0
    if lines and lines[0].startswith("# "):
        k = 1
        while k < len(lines) and not lines[k].strip():
            k += 1
        while k < len(lines) and lines[k].strip():
            k += 1
    return "\n".join(lines[:k] + ["", block, ""] + lines[k:]).replace("\n\n\n\n", "\n\n\n")


HOOK_EVENT = "UserPromptSubmit"


def hook_entries(settings):
    return settings.setdefault("hooks", {}).setdefault(HOOK_EVENT, [])


def is_ours(entry):
    return any("bin/ptt inbox" in h.get("command", "") for h in entry.get("hooks", []))


def read_settings(path):
    """The settings file's JSON, {} if absent, None if unreadable."""
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text() or "{}")
        if not isinstance(data, dict) or not isinstance(data.get("hooks", {}), dict):
            return None
        entries = data.get("hooks", {}).get(HOOK_EVENT, [])
        if not isinstance(entries, list):
            return None
        for entry in entries:
            if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list):
                return None
            if any(not isinstance(h, dict) or not isinstance(h.get("command", ""), str)
                   for h in entry["hooks"]):
                return None
        return data
    except ValueError:
        return None


def write_settings(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")


def apply_hook(root, rel, e, before, opts, report):
    """Partitur's entry in a tool's settings file; everything else there stays."""
    path = root / rel
    want = json.loads(e["data"])
    data = read_settings(path)
    if data is None:
        report("not merged", path, "invalid hook settings; add the prompt hook by hand: "
               + json.dumps(want))
        return
    existed = path.exists()
    entries = hook_entries(data)
    ours = [x for x in entries if is_ours(x)]
    if ours == [want]:
        report("kept", path, "Partitur's prompt hook")
        return
    untouched = not ours or (len(ours) == 1 and before is not None
                            and before["sha"] == sha(json.dumps(ours[0])))
    if ours and not (opts.update and (untouched or opts.force)):
        report("outdated" if untouched else "modified", path, "Partitur's prompt hook; "
               + ("--update replaces it" if untouched else "--update --force replaces it"))
        return
    if ours and not untouched:
        backup(path, root, opts, report)
    entries[:] = [x for x in entries if not is_ours(x)] + [want]
    write_settings(path, data)
    report("updated" if ours else "merged" if existed else "created", path,
           "Partitur's prompt hook")


def remove_hook(root, rel, e, opts, report):
    path = root / rel
    data = read_settings(path)
    if data is None:
        report("not merged", path, "invalid hook settings; left alone")
        return False
    if not data:
        return not path.exists()
    entries = hook_entries(data)
    ours = [x for x in entries if is_ours(x)]
    if not ours:
        return True
    if len(ours) != 1 or sha(json.dumps(ours[0])) != e["sha"]:
        if not opts.force:
            report("modified", path, "Partitur's prompt hook; kept (--force removes it)")
            return False
        backup(path, root, opts, report)
    entries[:] = [x for x in entries if not is_ours(x)]
    if not entries:
        del data["hooks"][HOOK_EVENT]
    if not data["hooks"]:
        del data["hooks"]
    if data:
        write_settings(path, data)
        report("removed", path, "Partitur's prompt hook; the other settings stay")
    else:
        path.unlink()
        report("removed", path)
        prune(path.parent, root)
    return True


def backup(path, root, opts, report):
    """Copy path into the backup directory before a forced change."""
    if not path.exists() or path.is_symlink():
        return
    if opts.backup_dir is None:
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        opts.backup_dir = (Path(opts.backup_to).resolve() if opts.backup_to
                           else root / f"partitur-backup-{stamp}")
    target = opts.backup_dir / path.relative_to(root)
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, target)
    report("backed up", path, f"to {os.path.relpath(target, root)}")


def apply_rules(root, rel, e, before, opts, report):
    path = root / rel
    want = block_of(e["data"].decode())
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(e["data"])
        report("created", path)
        return
    text = path.read_text()
    cur = block_of(text)
    if cur is None:
        if opts.merge_rules:
            path.write_text(merge_block(text, want))
            report("merged", path, "Partitur's rules block added; " + AGENT_HINT)
        else:
            report("not merged", path, "the project's rules lack Partitur's block; "
                   "--merge-rules adds it. " + AGENT_HINT)
        return
    if cur == want:
        report("kept", path)
        return
    untouched = before is not None and before["sha"] == sha(cur)
    if opts.update and (untouched or opts.force):
        if not untouched:
            backup(path, root, opts, report)
        path.write_text(text.replace(cur, want))
        report("updated" if untouched else "replaced", path, "Partitur's rules block")
    else:
        report("outdated" if untouched else "modified", path,
               "Partitur's rules block; --update replaces it" if untouched else
               "Partitur's rules block was edited here; --update --force replaces it")


def apply(root, plan, old, opts, report):
    """Bring the project to `plan` (rel path -> entry with kind, data or
    target); `old` is what the installing Partitur commit delivered."""
    old = old or {}
    mode, force = ("update" if opts.update else "install"), opts.force
    for rel, e in plan.items():
        path, before = root / rel, old.get(rel)
        if e["kind"] == "rules":
            apply_rules(root, rel, e, before, opts, report)
            continue
        if e["kind"] == "hook":
            apply_hook(root, rel, e, before, opts, report)
            continue
        if e["kind"] == "link":
            if path.is_symlink() and os.readlink(path) == e["target"]:
                report("kept", path)
            elif path.is_symlink() and before and os.readlink(path) == before["target"] \
                    and mode == "update":
                path.unlink()
                path.symlink_to(e["target"])
                report("updated", path)
            elif path.exists() or path.is_symlink():
                report("differs", path, "not Partitur's link; left alone")
                continue
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.symlink_to(e["target"])
                report("created", path)
            continue
        want = sha(e["data"])
        cur = file_sha(path)
        if cur is None and not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(e["data"] if isinstance(e["data"], bytes) else e["data"].encode())
            if e.get("mode"):
                path.chmod(e["mode"])
            report("created", path)
        elif e["kind"] == "seeded":
            report("kept", path, "the project's file")
        elif cur == want:
            report("kept", path)
        else:
            untouched = before is not None and before["sha"] == cur
            if mode == "update" and (untouched or force):
                if not untouched:
                    backup(path, root, opts, report)
                path.write_bytes(e["data"] if isinstance(e["data"], bytes) else e["data"].encode())
                if e.get("mode"):
                    path.chmod(e["mode"])
                report("updated" if untouched else "replaced", path)
            elif before is None:
                report("differs", path, "not installed by Partitur; --update --force replaces "
                       "it, after a backup")
            else:
                report("outdated" if untouched else "modified", path,
                       "--update replaces it" if untouched else
                       "changed here; --update --force replaces it")
    for rel, before in old.items():
        if rel in plan:
            continue
        path = root / rel
        if before["kind"] == "seeded":
            note = SUPERSEDED.get(Path(rel).relative_to(opts.records).as_posix())
            if note and path.exists():
                report("superseded", path, note)
            continue
        if mode != "update":
            if before["kind"] != "seeded" and (path.exists() or path.is_symlink()):
                report("obsolete", path, "--update removes it")
            continue
        remove_entry(root, rel, before, opts, report)


def remove_entry(root, rel, e, opts, report):
    """Remove what install delivered at rel, if it is still what it delivered."""
    path = root / rel
    if e["kind"] == "seeded":
        if path.exists():
            report("kept", path, "the project's file")
        return False
    if e["kind"] == "rules":
        if not path.exists():
            return True
        text = path.read_text()
        cur = block_of(text)
        if cur is None:
            report("kept", path, "the project's file")
            return False
        if sha(cur) != e["sha"] and not opts.force:
            report("modified", path, "Partitur's rules block was edited here; kept "
                   "(--force removes it)")
            return False
        if sha(cur) != e["sha"]:
            backup(path, root, opts, report)
        path.write_text(text.replace(cur + "\n", "").replace(cur, ""))
        report("removed", path, "Partitur's rules block; the project's rules stay")
        return False
    if e["kind"] == "hook":
        return remove_hook(root, rel, e, opts, report)
    if e["kind"] == "link":
        if path.is_symlink() and os.readlink(path) == e["target"]:
            path.unlink()
            report("removed", path)
            prune(path.parent, root)
            return True
        return not (path.exists() or path.is_symlink())
    if not path.exists():
        return True
    if file_sha(path) == e["sha"] or opts.force:
        if file_sha(path) != e["sha"]:
            backup(path, root, opts, report)
        path.unlink()
        report("removed", path)
        prune(path.parent, root)
        return True
    report("modified", path, "changed here; kept (--force removes it, after a backup)")
    return False


def prune(d, root):
    """Remove directories left empty, up to root."""
    while d != root and d.is_dir() and not any(d.iterdir()):
        d.rmdir()
        d = d.parent


def detect(root, rec):
    """Primary Git checkouts directly under root, as [name, checkout, main]."""
    found = []
    for d in sorted(p for p in root.iterdir() if p.is_dir()):
        if d.resolve() in (rec.resolve(), HERE) or not (d / ".git").is_dir():
            continue
        if any(c.isspace() or c == ":" for c in d.name):
            print(f"warning    {d.name}: name contains a space or colon; add it by hand")
            continue
        r = subprocess.run(["git", "-C", str(d), "symbolic-ref", "--short", "-q", "HEAD"],
                           capture_output=True, text=True)
        if r.returncode or not r.stdout.strip():
            print(f"warning    {d.name}: no branch checked out; add it by hand")
            continue
        branch = r.stdout.strip()
        found.append([d.name, d.name, branch])
        print(f"found      {d.name} (main branch {branch})")
        if branch not in ("main", "master"):
            print(f"warning    {d.name}: is {branch} its main branch? if not, correct pr/repos")
    return found


def scope_user(a, tools, report):
    for tool in tools:
        link = Path.home() / TOOLS[tool][1] / "skills" / "partitur"
        if a.uninstall:
            if link.is_symlink() and Path(os.readlink(link)) == HERE:
                link.unlink()
                report("removed", link)
            elif link.exists() or link.is_symlink():
                report("differs", link, "not a link to this Partitur; left alone")
        elif link.is_symlink() and Path(os.readlink(link)) == HERE:
            report("kept", link)
        elif link.exists() or link.is_symlink():
            report("differs", link, "not a link to this Partitur; left alone")
        else:
            link.parent.mkdir(parents=True, exist_ok=True)
            link.symlink_to(HERE)
            report("created", link)


def project_plan(a, tools, repos, name, src, quiet=False):
    """Everything install delivers to the project from Partitur source `src`,
    as rel path -> entry. Tools and skills are whatever `src` ships."""
    plan = {}
    R = a.records

    def fill(template):
        text = src.read(f"templates/{template}").decode()
        return (text.replace("{{PROJECT}}", name).replace("{{RECORDS}}", R)
                .replace("{{PARTITUR}}", URL)
                .replace("{{PROJECT_RULES}}", "(Rules specific to this project.)"))

    def add(rel, kind, data, mode=None):
        plan[rel] = dict(kind=kind, data=data if isinstance(data, bytes) else data.encode(),
                         mode=mode)
    add(f"{R}/CLAUDE.md", "rules", fill("rules.md"))
    add(f"{R}/pr/README.md", "maintained", fill("pr-README.md"))
    for d in ("pr/open", "pr/merged", "pr/closed", "tasks/open", "tasks/done", "tasks/cancelled",
              "roles/integrator", "handoff/notes"):
        add(f"{R}/{d}/.gitkeep", "seeded", "")
    add(f"{R}/pr/repos", "seeded",
        "# name checkout main\n" + "".join(f"{n} {c} {m}\n" for n, c, m in repos))
    if src.has("templates/root-charter.md"):
        add(f"{R}/tasks/open/T0000-design/charter.md", "seeded", fill("root-charter.md"))
        add(f"{R}/tasks/open/T0000-design/status.md", "seeded", fill("root-status.md"))
    else:                         # earlier Partitur: the designer was a role
        add(f"{R}/handoff/designer.md", "seeded", fill("designer.md"))
        add(f"{R}/roles/designer/.gitkeep", "seeded", "")
    add(f"{R}/handoff/integrator.md", "seeded", fill("integrator.md"))
    for tool in src.names("project/bin"):
        add(f"{R}/bin/{tool}", "maintained", src.read(f"project/bin/{tool}"), 0o755)
    add(f"{R}/tasks/charter-template.md", "maintained", src.read("templates/charter.md"))
    skills = src.names("project/skills")
    for skill in skills:
        template = f"project/skills/{skill}/SKILL.md.in"
        if not src.has(template):  # installed versions before templates were renamed
            template = f"project/skills/{skill}/SKILL.md"
        text = src.read(template).decode()
        add(f"{R}/skills/{skill}/SKILL.md", "maintained", text.replace("<records>", R))
    for tool in tools:
        entry, tool_dir = TOOLS[tool]
        plan[entry] = dict(kind="link", target=f"{R}/CLAUDE.md")
        for skill in skills:
            plan[f"{tool_dir}/skills/{skill}"] = dict(kind="link",
                                                      target=f"../../{R}/skills/{skill}")
        if (Path.home() / tool_dir / "skills" / "partitur").exists():
            if not quiet:
                print(f"skipped    {tool_dir}/skills/partitur (linked for the user already)")
        else:
            plan[f"{tool_dir}/skills/partitur"] = dict(kind="link", target=str(HERE))
        if tool == "claude" and b"def cmd_inbox" in src.read("project/bin/ptt"):
            hook = {"hooks": [{"type": "command",
                               "command": f'"$CLAUDE_PROJECT_DIR"/{R}/bin/ptt inbox --quiet'}]}
            add(".claude/settings.json", "hook", json.dumps(hook))
        if tool == "codex" and b"def read_hook_session" in src.read("project/bin/ptt"):
            command = shlex.quote(str(a.project.resolve() / R)) + "/bin/ptt inbox --quiet --hook"
            hook = {"hooks": [{"type": "command", "command": command}]}
            add(".codex/hooks.json", "hook", json.dumps(hook))
    return plan


def records_lock(rec):
    """The lock every ptt command takes (F11), so that install never writes
    while a session records: the flock older ptt versions take, and the lock
    directory of this Partitur's ptt, taken with its own code."""
    r = subprocess.run(["git", "-C", str(rec), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    gitdir = (rec / r.stdout.strip()).resolve()
    sys.dont_write_bytecode = True        # no __pycache__ among the files install ships
    loader = importlib.machinery.SourceFileLoader("ptt", str(HERE / "project" / "bin" / "ptt"))
    ptt = importlib.util.module_from_spec(importlib.util.spec_from_loader("ptt", loader))
    loader.exec_module(ptt)
    atexit.register(ptt.release_dir, ptt.acquire(gitdir))
    f = open(gitdir / "ptt.lock", "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def merge_repos(repos, extra):
    names = {r[0] for r in repos}
    return repos + [r for r in extra if r[0] not in names]


def read_table(table):
    rows = []
    for line in table.read_text().splitlines() if table.exists() else []:
        parts = line.split("#", 1)[0].split()
        if len(parts) == 3:
            rows.append(parts)
    return rows


def set_repos(a, root, rec, table, repos, add_repos, report):
    """--repo: the table holds exactly these; --add-repo: these are added.
    Then warn about repositories that requests name but the table lacks."""
    current = read_table(table)
    if a.repo and current != repos:
        if table.exists() and current:
            backup(table, root, a, report)
        table.write_text("# name checkout main\n" + "".join(f"{n} {c} {m}\n" for n, c, m in repos))
        report("replaced", table, "exactly the --repo repositories")
        current = repos
    new = [r for r in add_repos if r[0] not in {c[0] for c in current}]
    if new:
        with table.open("a") as f:
            for n, c, m in new:
                f.write(f"{n} {c} {m}\n")
        report("updated", table, "added " + ", ".join(r[0] for r in new))
        current = current + new
    for n, c, _ in current:
        if not (root / c / ".git").exists():
            print(f"warning    repository {n}: no Git checkout at {c}")
    named = set()
    for req in rec.glob("pr/*/*/0001-request.md"):
        for line in req.read_text().splitlines():
            if line.startswith("repo:"):
                named.add(line.split(":", 1)[1].strip())
    missing = sorted(named - {c[0] for c in current} - {"", "?"})
    for n in missing:
        print(f"warning    requests name repository {n}, which pr/repos lacks; add it with "
              f"--add-repo {n}:<checkout>:<main branch>")


def read_stamp(path):
    if not path.exists():
        return None
    for line in path.read_text().splitlines():
        if line.startswith("partitur "):
            value = line.split(" ", 1)[1].strip()
            return None if value == "uncommitted" else value
    return None


def redundant_links(root, tools):
    """The project's own `partitur` links to this Partitur that a user-scope
    link makes redundant: with both, Codex would list the skill twice."""
    out = []
    for tool in tools:
        tool_dir = TOOLS[tool][1]
        link = root / tool_dir / "skills" / "partitur"
        if ((Path.home() / tool_dir / "skills" / "partitur").exists() and link.is_symlink()
                and Path(os.readlink(link)) == HERE):
            out.append(link)
    return out


def scope_project(a, tools, report):
    root = a.project.resolve()
    if not root.is_dir():
        sys.exit(f"install: {root} is not a directory")
    if "/" in a.records or a.records in ("", ".", ".."):
        sys.exit("install: --records must be a directory name directly in the project")
    rec = root / a.records
    stamp = rec / ".partitur-version"
    held = records_lock(rec) if (rec / ".git").exists() else None
    name = a.name or root.name
    before = read_stamp(stamp)
    if before and not known_commit(before):
        print(f"warning    this Partitur clone does not have commit {before[:12]}, which "
              "installed the project; files no longer shipped cannot be found")
        before = None
    old = delivered(project_plan(a, tools, [], name, Source(before), quiet=True)) if before else None

    if a.uninstall:
        if not stamp.exists():
            sys.exit(f"install: {stamp.relative_to(root)} not found; nothing to uninstall")
        if old is None:
            print("warning   unknown installing commit; comparing with this Partitur instead")
            old = delivered(project_plan(a, tools, [], name, Source(), quiet=True))
        kept = [rel for rel, e in old.items() if not remove_entry(root, rel, e, a, report)]
        for link in redundant_links(root, tools):
            link.unlink()
            report("removed", link)
        stamp.unlink()
        report("removed", stamp)
        if kept:
            print(f"\n{len(kept)} path(s) kept: the project's own files, or files changed "
                  "here (--force removes changed ones). Records (tasks, requests, roles) are "
                  "never touched.")
        print(f"\nRecord the change: {a.records}/bin/ptt record -m \"uninstall Partitur\" "
              f"{a.records}  (or with git, if bin/ptt was removed)")
        return

    def parse(specs, option):
        out = []
        for spec in specs:
            parts = spec.split(":")
            if len(parts) != 3 or not all(parts) or any(c.isspace() for c in spec):
                sys.exit(f"install: {option} {spec!r}: expected NAME:CHECKOUT:MAIN, "
                         "no spaces or colons in a field")
            out.append(parts)
        return out
    repos = parse(a.repo, "--repo")
    add_repos = parse(a.add_repo, "--add-repo")
    if (rec / ".git").exists():
        has_commits = not subprocess.run(["git", "-C", str(rec), "rev-parse", "-q", "--verify",
                                          "HEAD"], capture_output=True).returncode
        if has_commits and not (rec / "pr").exists():
            sys.exit(f"install: {rec} is an existing repository that is not a records "
                     "repository; choose another --records")
        report("kept", rec / ".git")
    else:
        rec.mkdir(exist_ok=True)
        subprocess.run(["git", "init", "-q", "-b", a.branch, str(rec)], check=True)
        report("created", rec / ".git")
    held = held or records_lock(rec)
    table = rec / "pr" / "repos"
    if not table.exists() and not a.repo:
        repos = detect(root, rec)
    for tool in tools:
        entry = root / TOOLS[tool][0]
        if entry.exists() and not entry.is_symlink():
            print(f"warning    {entry.name} exists and is not the rules file, so the tool would "
                  f"not read the rules: move its content into {a.records}/CLAUDE.md, delete "
                  "it, and rerun")
    plan = project_plan(a, tools, merge_repos(repos, add_repos), name, Source())
    apply(root, plan, old, a, report)
    for link in redundant_links(root, tools):
        if a.update:
            link.unlink()
            report("removed", link, "linked for the user already")
        else:
            report("redundant", link, "linked for the user already; --update removes it")
    set_repos(a, root, rec, table, repos, add_repos, report)
    now = partitur_commit()
    c = report.counts
    pending = any(c.get(k) for k in ("outdated", "obsolete", "superseded", "redundant"))
    if not stamp.exists() or a.update or not pending:
        stamp.write_text("partitur " + (now or "uncommitted") + "\n")
    if not now:
        print("\nwarning   this Partitur has uncommitted changes; a later update cannot find "
              "files it no longer ships. Install from a committed Partitur.")
    if (c.get("outdated") or c.get("obsolete") or c.get("redundant")) and not a.update:
        print("\nThis Partitur is newer: rerun with --update to bring the project up to it.")
    if c.get("superseded"):
        print("\nSuperseded files hold the project's content, so Partitur never removes them: "
              "move what they hold as noted, delete them, and record the change.")
    if c.get("modified") or c.get("differs"):
        print("\nFiles changed here, or not installed by Partitur, were left alone; "
              "--update --force replaces them after a backup.")
    if a.backup_dir:
        print(f"\nBackups of replaced or removed files: {a.backup_dir}")
    if c.get("not merged"):
        print("\nThe project's rules lack Partitur's block: " + AGENT_HINT
              + " Then rerun with --merge-rules.")
    if any(c.get(k) for k in ("created", "updated", "replaced", "removed", "merged")):
        print(f"\nRecord the change: {a.records}/bin/ptt record -m \"install Partitur\" "
              f"{a.records}")


def main():
    ap = argparse.ArgumentParser(prog="install", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tool", choices=("auto", "claude", "codex", "all"), default="auto")
    ap.add_argument("--scope", choices=("user", "project"))
    ap.add_argument("project", type=Path, nargs="?", default=Path("."))
    ap.add_argument("--name", help="project name (default: the directory's name)")
    ap.add_argument("--records", default="workspace", help="records repository directory")
    ap.add_argument("--branch", default="master", help="records repository's main branch")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--update", action="store_true",
                      help="bring the project up to this Partitur: replace delivered files not "
                           "changed since, remove those no longer delivered")
    mode.add_argument("--uninstall", action="store_true",
                      help="remove what install delivered and is unchanged; keep the project's "
                           "files and all records")
    ap.add_argument("--force", action="store_true",
                    help="with --update or --uninstall: also replace or remove files changed "
                         "here, after copying them to a backup directory")
    ap.add_argument("--backup-to", metavar="PATH",
                    help="where --force puts its backups (default: "
                         "PROJECT/partitur-backup-<UTC time>/)")
    ap.add_argument("--merge-rules", action="store_true",
                    help="add Partitur's rules block to an existing rules file")
    ap.add_argument("--repo", action="append", default=[], metavar="NAME:CHECKOUT:MAIN",
                    help="the repository table holds exactly these (repeatable); CHECKOUT "
                         "relative to PROJECT")
    ap.add_argument("--add-repo", action="append", default=[], metavar="NAME:CHECKOUT:MAIN",
                    help="add these to the repository table (repeatable)")
    a = ap.parse_args()
    a.backup_dir = None
    if not a.scope:
        print(__doc__)
        sys.exit(2)
    if a.force and not (a.update or a.uninstall):
        sys.exit("install: --force goes with --update or --uninstall")
    if a.tool == "auto":
        found = {"claude": shutil.which("claude") or (Path.home() / ".claude").is_dir(),
                 "codex": shutil.which("codex") or (Path.home() / ".codex").is_dir()}
        tools = tuple(t for t in ("claude", "codex") if found[t])
        if not tools:
            sys.exit("install: found neither Claude Code nor Codex on this machine; "
                     "choose with --tool claude, codex, or all")
        print("detected " + " and ".join({"claude": "Claude Code", "codex": "Codex"}[t]
                                          for t in tools) + "; using "
              + ("both" if len(tools) == 2 else "it") + " (--tool chooses otherwise)")
    else:
        tools = ("claude", "codex") if a.tool == "all" else (a.tool,)
    report = Report(a.project.resolve() if a.scope == "project" else Path.home())
    if a.scope == "user":
        scope_user(a, tools, report)
    elif a.uninstall:
        scope_project(a, tools, report)
    else:
        out, sys.stdout = sys.stdout, Tee(sys.stdout)
        try:
            scope_project(a, tools, report)
        finally:
            output, sys.stdout = sys.stdout.text(), out
        write_report(a, tools, report, output)


class Tee:
    """Standard output that is also kept, for the report file."""

    def __init__(self, out):
        self.out, self.parts = out, []

    def write(self, text):
        self.parts.append(text)
        return self.out.write(text)

    def flush(self):
        self.out.flush()

    def text(self):
        return "".join(self.parts)


REPORT = "partitur-install-report.md"


def write_report(a, tools, report, output):
    """Write what this run did and what is left to do, for an agent session to
    read; a later run overwrites it. It lies outside the records repository so
    that recording the records never commits it."""
    root = a.project.resolve()
    c, R = report.counts, a.records
    steps = []
    loose = [root / TOOLS[t][0] for t in tools
             if (root / TOOLS[t][0]).exists() and not (root / TOOLS[t][0]).is_symlink()]
    if c.get("not merged") or c.get("merged") or loose:
        own = " and ".join(f"`{p.name}` in the workspace root" for p in loose) \
            if loose else f"`{R}/CLAUDE.md`"
        steps.append(
            f"Rules. Compare Partitur's rules block (`{HERE / 'templates' / 'rules.md'}`, "
            f"between the `partitur rules` markers) with the project's rules in {own}. "
            f"Installing Partitur already chose its rules: ask the user only where the "
            f"project deliberately differs. Remove duplicates of the block (list them, do not "
            f"ask); keep domain rules and the project's concrete instances of the block's "
            f"rules unchanged (do not ask); ask one question per conflict, with a "
            f"recommendation, and one question for adopting the block's rules the project "
            f"lacks (name those labelled Proposed in `{HERE / 'rules.md'}`: not yet exercised "
            f"in practice). See Partitur's SKILL.md, step Rules. "
            + ("On the user's approval, rerun this install with --merge-rules. "
               if c.get("not merged") else "")
            + f"Then write the project's part of `{R}/CLAUDE.md` after the block, as "
            "\"## Project Rules\": domain rules, the project's instances, and each kept "
            "conflict as a stated deviation (the block itself is never edited).")
    for p in loose:
        steps.append(f"`{p.name}` in the workspace root is a file, so the agent tool does not "
                     f"read `{R}/CLAUDE.md`: once its rules are merged, delete it with the "
                     "user's approval and rerun this install, which then links it.")
    if any(line.startswith("warning") for line in output.splitlines()):
        steps.append("Warnings: explain each line starting with `warning` in the output to "
                     "the user, with what to do about it.")
    if "codex" in tools:
        steps.append("Codex: start in the workspace root and review/trust "
                     "`.codex/hooks.json` in Codex (`/hooks` in the CLI). The prompt hook "
                     "delivers inbox updates only after it is trusted. Use `$ptt-inbox` "
                     "manually if hooks are unavailable. After moving this workspace, "
                     "update the hook's absolute path and review/trust it again.")
    for kind, rel in report.paths:
        if kind == "superseded":
            steps.append(f"Superseded: `{rel}` holds the project's content; move it as the "
                         "report line says, with the user's approval, then delete it.")
    if any(k == "created" and rel.endswith("T0000-design/charter.md")
           for k, rel in report.paths):
        steps.append(f"Root design task: fill in `{R}/tasks/open/T0000-design/charter.md` "
                     "with the user (this first fill-in is a direct edit). If the project has "
                     "its own design handover, the user may leave this to the designer, who "
                     "proposes it on taking T0000. Anything about the design agreed during "
                     "the setup goes into T0000's charter or `status.md`.")
    if c.get("modified") or c.get("differs"):
        steps.append("Files reported \"modified\" or \"differs\" were left alone: tell the "
                     "user which matter, and whether `--update --force` (with a backup) or "
                     "keeping them is better.")
    if c.get("outdated") or c.get("obsolete") or c.get("redundant"):
        steps.append("Files reported \"outdated\", \"obsolete\", or \"redundant\": "
                     "`--update` brings them up to this Partitur; ask the user.")
    unlinked = [t for t in tools
                if not (Path.home() / TOOLS[t][1] / "skills" / "partitur").exists()]
    if unlinked:
        steps.append("Optional, only with the user's approval: Partitur is linked for this "
                     "project only. To let sessions in any directory find it (for example "
                     "to install it in the next project by asking a session), run "
                     f"`{HERE / 'bin' / 'install'} --scope user --tool "
                     f"{unlinked[0] if len(unlinked) == 1 else 'all'}`, then rerun this "
                     "install with `--update`, which removes the project's own link.")
    if any(c.get(k) for k in ("created", "updated", "replaced", "removed", "merged")):
        steps.append(f"When the steps above are done, record the records repository: "
                     f"`{R}/bin/ptt record -m \"install Partitur\" {R}`.")
    if c.get("created"):
        steps.append("This is the installation session: it takes no role. Tell the user to open "
                     "fresh sessions in the workspace root for the roles (`/ptt-take designer`, "
                     "`/ptt-take integrator`), which start from the records, and that requests "
                     "wait until a session holds the integrator role.")
    when = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ")
    text = (f"# Partitur install report\n\n"
            f"- When: {when}\n- Partitur: {partitur_commit() or 'uncommitted'}\n"
            f"- Command: `{' '.join([Path(sys.argv[0]).name] + sys.argv[1:])}`\n"
            f"- Project: `{root}`, records `{R}/`\n\n"
            "Written by Partitur's install for the user and an agent session; not part of "
            "the records, never committed, overwritten by the next install run. Delete it "
            "when its steps are done.\n\n## Output\n\n```\n" + output.strip() + "\n```\n\n"
            "## Next steps, for an agent session\n\n"
            "Nothing here authorizes writes: each step that writes needs the user's "
            "approval (AtE).\n\n"
            + ("".join(f"{i}. {t}\n" for i, t in enumerate(steps, 1)) if steps
               else "None: the project is up to date with this Partitur.\n"))
    (root / REPORT).write_text(text)
    print(f"\nThis report and the next steps are in {REPORT} (not committed). In an agent "
          f"session started in {root}, say:\n\n"
          f"    Read {REPORT} and help me finish the Partitur install.\n")


if __name__ == "__main__":
    main()
