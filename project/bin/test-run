#!/usr/bin/env python3
"""Create and clean up run records (Partitur, flows/evidence.md).

Usage:
  test-run new REPO_PATH [--root DIR]
  test-run gc [PATH...] [--root DIR] [--as NAME] [--request N] [--scratch DIR]

`new` creates <root>/<id>/ with id = <UTC timestamp>-<short commit SHA>, for
example 20261009T061500Z-7099ba2, writes run.md with the checkout's identity
and its creator (`by:`, the holder bound to this session by `ptt`, beside
this tool; `unknown` without one), and prints the directory path. Its
`builds:` field accepts `[]` as empty, one relative path, or an indented
block list of relative paths; `new` writes `builds: []`. The caller puts the
command, logs, outputs, exit status and counts there; large outputs are
recorded by SHA-256, size, and a compact numerical summary. A run directory
is written by one run and never reused. The default root is test-runs/ in
the workspace root (the parent of the records repository holding this tool's
directory).

`gc` is read-only: it prints a table of the run records and the commands that
would remove what may go, and removes nothing. A run's head is the request
whose branch or head it tested, else the task whose worktree it ran in
(worktrees/<task slug> by convention, or a path the task's charter or
amendments name); without a request, a worktree still present keeps the
head open. The head is concluded
when its request is merged or closed, or its task done or cancelled. A run is
cited when its id appears in a file of the records repository at HEAD, in a
records commit message, or in a commit message of a main branch in pr/repos.
- head open: the run is kept whole;
- cited, head concluded: its declared build directories may go; directories
  found by the transition rule (named build or build-*, or holding
  CMakeCache.txt) are marked inferred and may also go after inspection;
- not cited, head concluded: the whole directory may go;
- no head (a main branch, detached, or not found) and not cited: listed
  apart, never in the commands unless named.
Commands are given only for runs whose `by` is the caller (the holder bound
to this session, or --as NAME); others' runs and runs without `by` are shown
for information. PATHs (run records or other paths the user named) are
listed alone and given commands whatever their `by`. --request N limits the table
to runs whose head is request N. --scratch DIR lists the top-level entries of
a session's scratchpad with their sizes and the commands that would remove
them. Every command is static: `rm -rf -- '<absolute path>'` for a directory,
`rm -- '<absolute path>'` for anything else, without globs or variables.
"""
import argparse
import importlib.machinery
import importlib.util
import os
import re
import shlex
import stat
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REC = HERE.parent
WS = REC.parent


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], check=True,
                          capture_output=True, text=True).stdout.strip()


def git_quiet(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return r.returncode, r.stdout


def sibling(name):
    """The tool `name` beside this one, loaded as a module, or None."""
    path = HERE / name
    if not path.is_file():
        return None
    sys.dont_write_bytecode = True    # no __pycache__ in the records' bin/
    loader = importlib.machinery.SourceFileLoader(f"partitur_{name}", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(module)
    except (Exception, SystemExit):
        return None
    return module


def bound_holder():
    """The holder bound to this session by ptt, or None."""
    ptt = sibling("ptt")
    if ptt is None:
        return None
    try:
        return ptt.bound_here()
    except (Exception, SystemExit):
        return None


def cmd_new(a):
    try:
        sha = git(a.repo, "rev-parse", "HEAD")
        branch = git(a.repo, "branch", "--show-current") or "(detached)"
        dirty = git(a.repo, "status", "--porcelain")
        top = git(a.repo, "rev-parse", "--show-toplevel")
    except subprocess.CalledProcessError as e:
        sys.exit(f"test-run: {a.repo} is not a usable Git checkout: {e.stderr.strip()}")

    a.root.mkdir(parents=True, exist_ok=True)
    for _ in range(5):
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        run = a.root / f"{stamp}-{sha[:7]}"
        try:
            run.mkdir()
            break
        except FileExistsError:
            time.sleep(1)
    else:
        sys.exit("test-run: could not allocate a unique run id")

    (run / "run.md").write_text(
        "---\n"
        f"id: {run.name}\n"
        f"created: {stamp}\n"
        f"by: {bound_holder() or 'unknown'}\n"
        f"checkout: {top}\n"
        f"branch: {branch}\n"
        f"commit: {sha}\n"
        f"worktree_clean: {'no' if dirty else 'yes'}\n"
        "builds: []\n"
        "---\n\n"
        "# Test run\n\n"
        "## Purpose\n\n## Commands\n\n## Environment\n\n"
        "## Results\nExit status and passed/failed/skipped counts.\n\n"
        "## Files\nSmall files (logs, reports, diagnostic tables), kept in full.\n\n"
        "## Large outputs\n"
        "Not kept once the run's head is concluded and nothing cites it; record\n"
        "each with its hash and a compact numerical summary for tolerance-based\n"
        "comparison.\n\n"
        "| File | SHA-256 | Bytes | Summary |\n"
        "| --- | --- | --- | --- |\n"
    )
    print(run)


# --- gc ---------------------------------------------------------------------

def disk_summary(path, seen, largest_limit=0):
    """Allocated bytes and largest regular files under `path`, in one walk.
    File sizes in the list are apparent sizes. Symbolic links are not
    followed, and files already in `seen` (device, inode) are not counted."""
    total = 0
    largest = []
    root = Path(path)
    try:
        st = os.lstat(path)
    except OSError:
        return 0, []

    stack = [(path, st)]
    while stack:
        p, info = stack.pop()
        if (info.st_dev, info.st_ino) in seen:
            continue
        seen.add((info.st_dev, info.st_ino))
        total += info.st_blocks * 512
        if largest_limit and stat.S_ISREG(info.st_mode):
            largest.append((info.st_size, str(Path(p).relative_to(root))))
            largest.sort(key=lambda item: (-item[0], item[1]))
            del largest[largest_limit:]
        if stat.S_ISDIR(info.st_mode):
            try:
                with os.scandir(p) as entries:
                    for entry in entries:
                        try:
                            stack.append((entry.path, entry.stat(follow_symlinks=False)))
                        except OSError:
                            pass
            except OSError:
                pass
    return total, largest


def disk_usage(path, seen):
    """Allocated bytes under `path`; see `disk_summary()` for the walk."""
    return disk_summary(path, seen)[0]


def inferred_build_dirs(run, declared=()):
    """Inferred build directories: named build or build-*, or holding
    CMakeCache.txt. Nothing below a declared directory is searched; an
    ancestor of one is walked into and not inferred. A chosen inferred
    directory ends the search below it. `declared` contains validated paths
    relative to `run`; returns (relative path, reason) pairs."""
    declared_paths = set(declared)
    ancestors = {parent for path in declared_paths for parent in path.parents}
    found = []
    for directory, dirs, files in os.walk(run):
        current = Path(directory).relative_to(run)
        dirs[:] = sorted(d for d in dirs if current / d not in declared_paths)
        if current == Path("."):
            continue
        reasons = []
        if current.name == "build" or current.name.startswith("build-"):
            reasons.append("name")
        if "CMakeCache.txt" in files:
            reasons.append("CMakeCache.txt")
        if reasons and current not in ancestors:
            found.append((current, ", ".join(reasons)))
            dirs[:] = []
    return sorted(found)


def human(n):
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024


def removal(path):
    rm = ["rm", "-rf", "--"] if path.is_dir() and not path.is_symlink() else ["rm", "--"]
    return shlex.join(rm + [str(path)])


def largest_text(files):
    return ", ".join(f"{name} ({human(size)})" for size, name in files) or "-"


def run_header(run):
    path = run / "run.md"
    if not path.is_file():
        return None
    fields = {}
    builds = None
    builds_errors = []
    section = None
    lines = path.read_text(errors="replace").splitlines()
    if lines and lines[0] == "---":
        for line in lines[1:]:
            if line == "---":
                break
            if line[:1].isspace():
                item = line.strip()
                if section == "builds" and item:
                    match = re.fullmatch(r"-\s+(.+)", item)
                    if match:
                        builds.append(match.group(1).strip())
                    else:
                        builds_errors.append(
                            (item, "expected a '- path' list item")
                        )
                continue
            key, sep, value = line.partition(":")
            if sep:
                key, value = key.strip(), value.strip()
                section = key
                if key == "builds":
                    if value in ("", "[]"):
                        builds = []
                    elif value.startswith("[") and value.endswith("]"):
                        builds = []
                        builds_errors.append(
                            (value, "flow lists are not supported; "
                                     "use one path or a block list"))
                    else:
                        builds = [value]
                else:
                    fields[key] = value
    if builds is not None:
        fields["builds"] = builds
        fields["builds_errors"] = builds_errors
    return fields


def declared_build_dirs(run, header):
    """(valid, invalid) declarations; valid maps relative paths to written text.
    Duplicate and nested paths are pruned without changing written order."""
    invalid = list(header.get("builds_errors", []))
    candidates = {}
    root = run.resolve()
    for text in header.get("builds", []):
        if "\0" in text:
            invalid.append((text, "path contains a null byte"))
            continue
        rel = Path(text)
        if rel.is_absolute():
            invalid.append((text, "absolute path"))
            continue
        if ".." in rel.parts:
            invalid.append((text, "leaves the run record"))
            continue
        current = run
        problem = None
        for part in rel.parts:
            current /= part
            try:
                mode = current.lstat().st_mode
            except OSError:
                problem = "does not exist"
                break
            if stat.S_ISLNK(mode):
                problem = "path contains a symbolic link"
                break
        if problem:
            invalid.append((text, problem))
            continue
        if not current.is_dir():
            invalid.append((text, "not a directory"))
            continue
        resolved = current.resolve()
        if resolved == root:
            invalid.append((text, "must be below the run record"))
            continue
        if root not in resolved.parents:
            invalid.append((text, "leaves the run record"))
            continue
        candidates.setdefault(rel, text)

    valid = {relative: text for relative, text in candidates.items()
             if not any(parent in candidates for parent in relative.parents)}
    return valid, invalid


class Heads:
    """Requests, tasks, and main branches, to find a run's head."""

    def __init__(self):
        self.requests, self.mains, self.tasks, self.notes = [], {}, [], []
        pr = sibling("pr")
        root = REC / "pr"
        if pr is None or not (root / "repos").is_file():
            self.notes.append(f"no request table ({root / 'repos'}): requests not consulted")
        else:
            try:
                pr.load_repos(root)
            except SystemExit as e:
                self.notes.append(f"request table unreadable: {e}")
            else:
                for name in pr.REPOS:
                    self.mains[name] = (pr.MAIN[name], (WS / pr.CHECKOUT[name]).resolve())
                for state, d in pr.requests(root, pr.STATES):
                    info, _ = pr.summarize(state, d)
                    if info is None:
                        continue
                    heads = {pr.front_matter(p).get("head", "") for p in pr.messages(d)}
                    self.requests.append(dict(number=d.name[:6], state=state, repo=info["repo"],
                                              branch=info["branch"], heads=heads - {"", "?"}))
        ptt = sibling("ptt")
        if ptt is None:
            self.notes.append("no ptt beside this tool: tasks not consulted")
            return
        try:
            for i in ptt.infos():
                text = "".join(p.read_text(errors="replace") for p in
                               [i["dir"] / "charter.md"]
                               + [e["path"] for e in ptt.events(i["dir"]) if e["kind"] == "amend"]
                               if p.is_file())
                self.tasks.append(dict(id=ptt.tid(i["number"]), slug=i["slug"],
                                       state=i["state"], text=text))
        except (Exception, SystemExit) as e:
            self.notes.append(f"tasks unreadable: {e}")

    def repo_of(self, checkout):
        """The repository name whose checkout or worktree `checkout` is, or None."""
        if not checkout.is_dir():
            for name, (_, primary) in self.mains.items():
                if checkout == primary:
                    return name
            return None
        rc, common = git_quiet(checkout, "rev-parse", "--path-format=absolute", "--git-common-dir")
        if rc:
            return None
        for name, (_, primary) in self.mains.items():
            rc, other = git_quiet(primary, "rev-parse", "--path-format=absolute",
                                  "--git-common-dir")
            if rc == 0 and other.strip() == common.strip():
                return name
        return None

    def task_of(self, rel):
        """The task whose worktree is `rel` (worktrees/<name>): by convention
        the task with slug <name>, the one not closed or cancelled if several
        share it; else a task whose charter or amendments name the path."""
        if len(rel.parts) == 2:
            same = [t for t in self.tasks if t["slug"] == rel.parts[1]]
            live = [t for t in same if t["state"] not in ("closed", "cancelled")]
            if len(same) == 1 or len(live) == 1:
                return same[0] if len(same) == 1 else live[0]
        mention = re.compile(re.escape(str(rel)) + r"(?![\w.-])")
        named = [t for t in self.tasks if mention.search(t["text"])]
        return named[0] if len(named) == 1 else None

    def find(self, h):
        """(head label, state, request number or None) for a run header; state
        is open, concluded, or none."""
        checkout = Path(h.get("checkout", "")).expanduser() if h.get("checkout") else None
        branch, commit = h.get("branch", ""), h.get("commit", "")
        repo = self.repo_of(checkout) if checkout else None
        mains = {self.mains[repo][0]} if repo else {m for m, _ in self.mains.values()}
        hits = [r for r in self.requests
                if (repo is None or r["repo"] == repo)
                and ((commit and commit in r["heads"])
                     or (branch and branch not in mains and branch != "(detached)"
                         and r["branch"] == branch))]
        if hits:
            open_ = [r for r in hits if r["state"] == "open"]
            r = (open_ or sorted(hits, key=lambda r: r["number"]))[-1]
            state = "open" if open_ else "concluded"
            return f"pr {r['number']} ({r['state']})", state, r["number"]
        if checkout and branch not in mains and branch != "(detached)":
            try:
                rel = checkout.resolve().relative_to(WS.resolve())
            except ValueError:
                rel = None
            if rel is not None and rel.parts[:1] == ("worktrees",):
                task = self.task_of(rel)
                if task:
                    concluded = task["state"] in ("closed", "cancelled")
                    return (f"{task['id']} ({task['state']})",
                            "concluded" if concluded else "open", None)
            if checkout.is_dir() and checkout != (self.mains[repo][1] if repo else None):
                return f"worktree {checkout}", "open", None
        return "none", "none", None


def citations(ids, mains):
    """Map run id -> places citing it: records files at HEAD, records commit
    messages, and commit messages of the main branches."""
    cited = {i: [] for i in ids}
    if not ids:
        return cited
    args = []
    for i in sorted(ids):
        args += ["-e", i]
    rc, out = git_quiet(REC, "grep", "-I", "-F", "-o", *args, "HEAD", "--")
    if rc == 0:
        for line in out.splitlines():
            rest, found = line.rsplit(":", 1)
            path = rest[len("HEAD:"):]
            if found in cited and path not in cited[found]:
                cited[found].append(path)
    logs = [("records", REC, "HEAD")] + [(name, path, main) for name, (main, path) in mains.items()]
    for name, repo, ref in logs:
        rc, out = git_quiet(repo, "log", "--format=%h%x00%B%x01", ref)
        if rc:
            continue
        for entry in out.split("\x01"):
            sha, _, body = entry.strip("\n").partition("\x00")
            for i in ids:
                if i in body:
                    cited[i].append(f"{name} {sha}")
    return cited


def scan(roots, named):
    """The run records to consider: every directory under the roots, and the
    named paths."""
    runs = []
    for root in roots:
        if root.is_dir():
            runs += sorted(p for p in root.iterdir() if p.is_dir() and not p.is_symlink())
    for p in named:
        if p not in runs:
            runs.append(p)
    return runs


def plan(a):
    """Rows and commands; nothing is executed."""
    caller = a.as_ or bound_holder()
    # Resolve the parent only: a named symbolic link is removed, not its target.
    named = [Path(os.path.realpath(os.path.dirname(os.path.abspath(p))),
                  os.path.basename(os.path.abspath(p))) for p in a.paths]
    for p in named:
        if not os.path.lexists(p):
            sys.exit(f"test-run: {p} does not exist")
    heads = Heads()
    runs = scan([] if named and a.request is None else [a.root.resolve()], named)
    headers = {r: run_header(r) for r in runs}
    cited = citations({r.name for r, h in headers.items() if h is not None}, heads.mains)
    seen = set()
    rows, apart = [], []
    declared_rows, inferred_rows, invalid_rows = [], [], []
    commands = {
        "declared build directories": [],
        "inferred build directories": [],
        "run records, named paths, and scratchpad": [],
    }
    for r in runs:
        h = headers[r]
        is_named = r in named
        if h is None:
            if not is_named:
                continue
            size = disk_usage(r, seen)
            rows.append((r.name, "-", human(size), "not a run record", "-", "-", "all", size))
            commands["run records, named paths, and scratchpad"].append(
                (removal(r), size))
            continue
        label, state, number = heads.find(h)
        if a.request is not None and number != a.request:
            continue
        by = h.get("by", "") or "-"
        cites = cited.get(r.name, [])
        size = disk_usage(r, set())
        mine = is_named or (caller is not None and by == caller)
        target_seen = seen if mine else set()
        targets = []
        invalid_note = ""
        if state == "open":
            goes = "nothing (head open)"
        elif state == "concluded" and not cites:
            goes = "all"
            targets.append(("run records, named paths, and scratchpad", r,
                            disk_usage(r, target_seen)))
        elif state == "concluded":
            declared, invalid = declared_build_dirs(r, h)
            inferred = inferred_build_dirs(r, declared)
            counts = []
            if declared:
                counts.append(f"{len(declared)} declared")
            if inferred:
                counts.append(f"{len(inferred)} inferred")
            if invalid:
                invalid_note = f"{len(invalid)} invalid declaration"
                if len(invalid) != 1:
                    invalid_note += "s"
            if counts:
                goes = "build: " + ", ".join(counts)
                if invalid_note:
                    goes += f"; {invalid_note}"
            elif invalid_note:
                goes = f"nothing ({invalid_note})"
            else:
                goes = "nothing (cited, no build directory)"
            for relative, text in declared.items():
                target = r / relative
                target_size = disk_usage(target, target_seen)
                declared_rows.append((r.name, by, text, target_size))
                targets.append(("declared build directories", target, target_size))
            for relative, reason in inferred:
                target = r / relative
                target_size, largest = disk_summary(target, target_seen, largest_limit=3)
                inferred_rows.append((r.name, by, str(relative), reason,
                                      largest_text(largest), target_size))
                targets.append(("inferred build directories", target, target_size))
            invalid_rows.extend(
                (r.name, by, text, problem) for text, problem in invalid)
        elif cites:
            goes = "nothing (cited, no head)"
        else:
            if is_named:
                goes = "all"
                targets.append(("run records, named paths, and scratchpad", r,
                                disk_usage(r, target_seen)))
            else:
                goes = "nothing (no head, not cited)"
        if not mine:
            if targets:
                goes = f"nothing (not yours; would go: {goes})"
            elif state == "concluded" and cites:
                goes = f"nothing (not yours; {invalid_note or 'no build directory'})"
        freed = 0
        if mine:
            for group, target, target_size in targets:
                commands[group].append((removal(target), target_size))
                freed += target_size
        row = (r.name, by, human(size), label, state,
               ", ".join(cites[:2]) + (f" +{len(cites) - 2}" if len(cites) > 2 else "")
               if cites else "none", goes, freed)
        (apart if state == "none" and not cites and not is_named else rows).append(row)
    return (caller, heads.notes, rows, apart, declared_rows, inferred_rows,
            invalid_rows, commands)


def table(rows, header, human_last=False):
    body = []
    for row in rows:
        values = [str(c) for c in row]
        if human_last:
            values[-1] = human(row[-1]) if row[-1] else "-"
        body.append(values)
    lines = [header] + body
    widths = [max(len(x[i]) for x in lines) for i in range(len(header))]
    for x in lines:
        print("  ".join(c.ljust(w) for c, w in zip(x, widths)).rstrip())


def cmd_gc(a):
    if a.request is not None:
        m = re.fullmatch(r"(?:pr-?)?0*(\d{1,6})", a.request.strip(), re.IGNORECASE)
        if not m:
            sys.exit(f"test-run: invalid request number: {a.request!r}")
        a.request = m.group(1).zfill(6)
    (caller, notes, rows, apart, declared_rows, inferred_rows,
     invalid_rows, commands) = plan(a)
    print(f"caller: {caller or 'unknown (no bound holder; --as NAME)'}")
    for n in notes:
        print(f"note: {n}")
    header = ("run", "by", "size", "head", "state", "cited by", "goes", "frees")
    if rows:
        print()
        table(rows, header, human_last=True)
    if apart:
        print("\nno head, not cited (information only; removed only when named):")
        table(apart, header, human_last=True)
    if not rows and not apart:
        print("no run records")
    if declared_rows:
        print("\ndeclared build directories:")
        table(declared_rows, ("run", "by", "path", "size"), human_last=True)
    if inferred_rows:
        print("\ninferred build directories:")
        table(inferred_rows,
              ("run", "by", "inferred path", "reason", "largest files", "size"),
              human_last=True)
    if invalid_rows:
        print("\ninvalid build declarations:")
        table(invalid_rows, ("run", "by", "entry", "reason"))
    if a.scratch:
        scratch = Path(os.path.abspath(a.scratch))
        entries = sorted(scratch.iterdir()) if scratch.is_dir() else []
        print(f"\nscratchpad {scratch}:")
        if not entries:
            print("  empty or not found")
        for p in entries:
            size = disk_usage(p, set())
            print(f"  {human(size):>7}  {p.name}{'/' if p.is_dir() and not p.is_symlink() else ''}")
            commands["run records, named paths, and scratchpad"].append(
                (removal(p), size))
    entries = [(name, items) for name, items in commands.items() if items]
    total = sum(size for _, items in entries for _, size in items)
    count = sum(len(items) for _, items in entries)
    print(f"\ncommands ({count}, frees {human(total)}):" if entries
          else "\ncommands: none")
    for name, items in entries:
        group_total = sum(size for _, size in items)
        print(f"{name} ({len(items)}, frees {human(group_total)}):")
        for command, _ in items:
            print(f"  {command}")


def main():
    ap = argparse.ArgumentParser(prog="test-run", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("new")
    p.add_argument("repo", type=Path)
    p.add_argument("--root", type=Path, default=WS / "test-runs")
    p = sub.add_parser("gc")
    p.add_argument("paths", nargs="*", help="run records or other paths the user named")
    p.add_argument("--root", type=Path, default=WS / "test-runs")
    p.add_argument("--as", dest="as_", metavar="NAME",
                   help="the caller's holder name (default: the holder bound to this session)")
    p.add_argument("--request", metavar="N", help="only runs whose head is request N")
    p.add_argument("--scratch", metavar="DIR", help="the session's scratchpad")
    a = ap.parse_args()
    cmd_new(a) if a.cmd == "new" else cmd_gc(a)


if __name__ == "__main__":
    main()
