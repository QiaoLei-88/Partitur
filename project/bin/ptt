#!/usr/bin/env python3
"""Roles and tasks of a Partitur project, kept as files in the records repository.

Usage (NAME is the holder name a session received when it took its role or
task; a task is given by its ID, `T0007` (also `0007` or `7`), sub-task
`T0007.1`, by its full name `T0007-slug`, or by its slug):
  ptt who                          who holds which role and task
  ptt handover NAME                leave a handover marker: a fresh session continues
                                   NAME with `ptt resume` and no name
  ptt unlock [--force]             remove the records lock if its owner is gone
                                   (--force: held on a machine that no longer exists)
  ptt whoami [NAME]                what NAME (default: the holder bound to this
                                   session) holds: role or task, supervisor, session
  ptt inbox [NAME] [--quiet] [--hook]
                                  what is new for NAME since it last looked, and what
                                   waits on it; --quiet prints only what is new, and
                                   nothing on any error (for a prompt hook)
                                   --hook reads a UserPromptSubmit JSON event on stdin
  ptt tasks [--all]                tasks and their states
  ptt show TASK                    a task's charter, status, and events
  ptt take designer|integrator|TASK   take the root design task T0000 (designer),
                                   the integrator role, or a ready task; prints the
                                   holder name
  ptt resume [NAME]                continue as NAME in this session (after /clear); without
                                   NAME, the holder with a handover marker, or a list of
                                   holders by their last write
  ptt leave NAME [--status TEXT]   give up the integrator role or T0000 (designer), or
                                   ask to give up any other task
  ptt approve-leave TASK --as NAME   supervisor: accept a holder's request to leave
  ptt free TASK|ROLE --as NAME --reason TEXT
                                   supervisor (or --as user): free a task or role whose
                                   holder is gone
  ptt mktask SLUG --as NAME [--kind track|worker|design] [--depends TASK,TASK]
                                   designer: create a draft task; prints its charter path
  ptt ready TASK --as NAME         designer: release a completed draft for taking
  ptt amend TASK --as NAME --text TEXT [--depends TASK,TASK]
                                   designer: amend a released charter
  ptt done TASK --as NAME [--requests N,N] [--text TEXT]
                                   holder: report the task's acceptance met
  ptt close TASK --as NAME         supervisor: accept the report; the hold ends
  ptt reopen TASK --as NAME --reason TEXT   supervisor: reject the report
  ptt cancel TASK --as NAME --reason TEXT   supervisor: cancel a task nobody holds
  ptt pr-move N merged|closed -m MESSAGE [--as NAME]
                                   integrator: move a decided request, recorded at once
  ptt record -m MESSAGE [--as NAME] PATH...
                                   commit exactly these paths of the records repository
                                   (request messages, status.md, handoff/integrator.md), under
                                   the same lock as every other change

Records: <records>/tasks/{open,done,cancelled}/TNNNN[.N...]-slug/ holds
charter.md (the designer's, from tasks/charter-template.md; frozen once
released), status.md (the holder's), and numbered event files
MMMM-<kind>.md, each written once. The task ID (T0007.2) and its directory
name never change. tasks/open/T0000-design/ is the root design task: it is
ready from the start, never done, closed, or cancelled, and its holders are
designer-g1, designer-g2, ...; other holders are named after the task
(design-T0007, track-T0007.1, and track-T0007.1-2 for the second take).
<records>/roles/integrator/ holds the integrator role's events. All
state is derived from the events. Every change runs under one lock (a
kernel file lock in the Git directory, released if the process dies), reads
the state, checks it, writes, and commits exactly its paths as one commit,
leaving everything else staged alone; if the commit fails, the change is
removed again. Every write to the
records repository goes through ptt (`ptt record` for request messages,
status.md, and handoff/integrator.md), so writes run one after another. Git commands
run by hand in the records repository while sessions work (stash,
checkout, a manual commit) are outside this guarantee.

Supervision: the holder of T0000 (the designer) supervises top-level tasks
T0001, T0002, ...; the holder of design task TN supervises TN.1, TN.2, ...;
the user supervises the designer, the
integrator, and any task whose supervisor is vacant (--as user). A holder
leaves a task only with its supervisor's approval. Nobody leaves, and no
design task is cancelled, while anything below it is unclear: a leave
request or done report waiting, or a holder with no record for STALE_DAYS.
Names given with --as are not authenticated: the records show who did what.

Sessions: PTT_SESSION_ID overrides the tool's ID: CLAUDE_CODE_SESSION_ID,
then CODEX_THREAD_ID, then CODEX_SESSION_ID for shell commands. `inbox --hook`
uses the event's session_id instead, unless PTT_SESSION_ID is set. Codex's
shell and hook IDs must identify the same session to find its bound holder.
`take` and `resume` bind the holder name to the ID. A write acting as a bound
holder (--as NAME, the NAME of `leave`) from another session is refused, and
so is any write from a session whose holder has since been resumed
elsewhere. Without a session ID (for example a plain terminal), nothing is
bound or checked.
"""
import argparse
import fcntl
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
from contextlib import contextmanager
from datetime import date
from pathlib import Path

REC = Path(__file__).resolve().parent.parent
TASKS = REC / "tasks"
ROLES = REC / "roles"
PLACES = ("open", "done", "cancelled")
TASK_DIR = re.compile(r"^T(\d{4}(?:\.\d+)*)-([a-z0-9][a-z0-9-]*)$")
ROOT = "0000"                      # the root design task, T0000-design
EVENT = re.compile(r"^(\d{4})-([a-z-]+)\.md$")
KINDS = ("track", "worker", "design")
STALE_DAYS = float(os.environ.get("PTT_STALE_DAYS", "7"))


def die(msg):
    sys.exit(f"ptt: {msg}")


def front_matter(path):
    lines = path.read_text().splitlines()
    fields, body = {}, ""
    if lines and lines[0] == "---":
        for i, line in enumerate(lines[1:], 1):
            if line == "---":
                body = "\n".join(lines[i + 1:]).strip()
                break
            key, sep, value = line.partition(":")
            if sep:
                fields[key.strip()] = value.strip()
    return fields, body


# --- records: lock, events, commits -----------------------------------------

def git_dir():
    r = subprocess.run(["git", "-C", str(REC), "rev-parse", "--git-common-dir"],
                       capture_output=True, text=True)
    if r.returncode:
        die(f"{REC} is not a Git repository")
    return (REC / r.stdout.strip()).resolve()


# The lock is a directory, `ptt.lock.d` in the records repository's Git
# directory: creating a directory is atomic wherever that directory lives, so
# sessions on several machines sharing the records repository exclude each
# other too. It names its owner (machine, process, process start), and a
# lock is removed only when its owner is known to be dead, never for its age:
# on this machine by checking the process, on another one only by `ptt unlock`
# run there, or by the user's `ptt unlock --force`. Older ptt versions took
# flock on `ptt.lock`; it is still taken, so that they are excluded during an
# update.

def machine_id():
    for f in ("/etc/machine-id", "/var/lib/dbus/machine-id"):
        try:
            return Path(f).read_text().strip()
        except OSError:
            pass
    return socket.gethostname()


def process_start(pid):
    """An identity of process `pid`'s start, so that a reused process number
    is not mistaken for the owner; None if it cannot be read."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        boot = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        return boot + ":" + stat.rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        pass
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True,
                           text=True)
    except OSError:
        return None
    return " ".join(r.stdout.split()) or None


def lock_owner(path):
    """The owner fields of the lock directory `path`, or None if it names no
    complete owner: it was removed meanwhile, or it is broken (its owner file
    is written before the directory appears, so it is never seen half made)."""
    try:
        owner = dict(line.split("=", 1) for line in (path / "owner").read_text().splitlines()
                     if "=" in line)
    except OSError:
        return None
    return owner if owner.get("machine") and owner.get("pid", "").isdigit() else None


def owner_alive(owner):
    """True or False for an owner on this machine, None for another machine."""
    if owner.get("machine") != machine_id():
        return None
    pid = int(owner.get("pid", "0"))
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    start = process_start(pid)
    return not (start and owner.get("start") and start != owner["start"])


def describe(owner):
    since = float(owner.get("since", "0"))
    return (f"{owner.get('host', '?')} process {owner.get('pid', '?')}, holding it for "
            f"{time.time() - since:.0f} s")


def take_dir(path):
    """Create the directory `path` with this process as its owner, atomically:
    an owner file is written into a private directory renamed into place."""
    tmp = path.with_name(f"{path.name}.{socket.gethostname()}.{os.getpid()}.tmp")
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir()
    pid = os.getpid()
    (tmp / "owner").write_text(f"host={socket.gethostname()}\nmachine={machine_id()}\n"
                               f"pid={pid}\nstart={process_start(pid) or ''}\n"
                               f"since={time.time()}\n")
    try:
        os.rename(tmp, path)
        return True
    except OSError:
        shutil.rmtree(tmp, ignore_errors=True)
        return False


def release_dir(path):
    owner = lock_owner(path)
    if owner and owner.get("machine") == machine_id() and owner.get("pid") == str(os.getpid()):
        shutil.rmtree(path, ignore_errors=True)


def break_stale(path, owner):
    """Remove the lock `path` of `owner`, known dead, unless another process
    did so meanwhile; breakers exclude each other with a lock of their own."""
    breaker = path.with_name(path.name + ".break")
    if not take_dir(breaker):
        dead = lock_owner(breaker)
        if dead and owner_alive(dead) is False:
            shutil.rmtree(breaker, ignore_errors=True)
        return
    try:
        if lock_owner(path) == owner:
            shutil.rmtree(path, ignore_errors=True)
            print(f"ptt: removed a stale lock of {owner.get('host')} process "
                  f"{owner.get('pid')}, which is gone", file=sys.stderr)
    finally:
        release_dir(breaker)


def acquire(gitdir, wait=None):
    """Take the records lock in `gitdir`; die after `wait` seconds."""
    path = Path(gitdir) / "ptt.lock.d"
    wait = float(os.environ.get("PTT_LOCK_WAIT", "60")) if wait is None else wait
    deadline = time.time() + wait
    while not take_dir(path):
        owner = lock_owner(path)
        if owner and owner_alive(owner) is False:
            break_stale(path, owner)
            continue
        if time.time() > deadline:
            if owner and owner_alive(owner) is None:
                die(f"the records are locked by {describe(owner)}, another machine. If that "
                    f"command is gone, run `ptt unlock` on {owner.get('host')}; only if that "
                    "machine no longer exists, `ptt unlock --force` here")
            die(f"the records are locked by {describe(owner)}, still running; try again"
                if owner else "the records are locked, but the lock names no owner: it is "
                "broken, unless it was just removed (try again; if it stays, `ptt unlock "
                "--force`)")
        time.sleep(0.1)
    return path


@contextmanager
def lock():
    """Serialize all changes of every session sharing the records."""
    path = acquire(git_dir())
    try:
        with open(git_dir() / "ptt.lock", "w") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            yield
    finally:
        release_dir(path)


def cmd_unlock(a):
    """Remove the records lock if its owner is gone; --force removes one held
    on another machine, for when that machine no longer exists."""
    path = git_dir() / "ptt.lock.d"
    owner = lock_owner(path)
    if not path.exists():
        print("the records are not locked")
        return
    alive = owner_alive(owner) if owner else None
    if alive is True:
        die(f"the lock is held by {describe(owner)}, which is running")
    if alive is None and not a.force:
        die((f"the lock is held by {describe(owner)}, another machine: run `ptt unlock` "
             f"there, or `ptt unlock --force` if {owner.get('host')} no longer exists")
            if owner else "the lock names no owner; `ptt unlock --force` removes it")
    shutil.rmtree(path)
    print("removed the lock of " + (describe(owner) if owner else "no owner"))


def git(*args, check=True, raise_=False):
    wait = float(os.environ.get("PTT_LOCK_WAIT", "60"))
    for _ in range(max(1, int(wait * 4))):
        r = subprocess.run(["git", "-C", str(REC), *args], capture_output=True, text=True)
        if "index.lock" not in r.stderr:
            break
        time.sleep(0.25)          # a git command outside ptt is busy
    if r.returncode and raise_:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.strip()}")
    if check and r.returncode:
        die(f"git {' '.join(args)} failed: {r.stderr.strip()}")
    return r


ACTOR = None                       # the holder this command writes as, when known


def record(message, add=(), remove=(), created=(), undo=None, shown=None):
    """Commit exactly `add` and `remove` (paths in the working tree, files or
    directories) as one commit, leaving everything else staged alone. The
    caller holds the lock. On any failure, `undo` runs, or the paths in
    `created` are removed, the touched paths are unstaged, and nothing is
    recorded. The message names the writer, `(by NAME)`, unless it does.
    What was written, `shown` or else `add` and `remove`, is reported with
    the commit, so that callers cite records as written, never inferred."""
    if ACTOR and ACTOR != "user" and not re.search(rf"by {re.escape(ACTOR)}\b(?![.-])", message):
        message += f" (by {ACTOR})"
    rel = [str(p.relative_to(REC)) for p in (*add, *remove)]
    staged = []                   # deleted with `git rm` already: the commit takes them as they are
    for path in rel:
        if (REC / path).exists() or git("ls-files", "--", path).stdout.strip():
            continue
        if not git("ls-tree", "HEAD", "--", path, check=False).stdout.strip():
            gone = git("log", "-1", "--format=%h", "--diff-filter=D", "--", path,
                       check=False).stdout.strip()
            die(f"{path} is not in the records" + (f": already deleted (records {gone})"
                                                   if gone else ""))
        staged.append(path)
    try:
        if len(staged) < len(rel):
            git("add", "-A", "--", *[x for x in rel if x not in staged], check=False, raise_=True)
        if git("diff", "--cached", "--quiet", "--", *rel, check=False).returncode == 0:
            return False
        git("commit", "-q", "-m", message, "--", *rel, check=False, raise_=True)
        commit = git("rev-parse", "--short", "HEAD").stdout.strip()
        wrote = [str(p.relative_to(REC)) for p in (shown if shown is not None else (*add, *remove))]
        print(f"wrote {', '.join(wrote)} (records {commit})", file=sys.stderr)
        return True
    except BaseException as err:
        git("reset", "-q", "--", *rel, check=False)
        if undo:
            undo()
        for p in created:
            if p.is_dir():
                shutil.rmtree(p, ignore_errors=True)
            else:
                p.unlink(missing_ok=True)
        if isinstance(err, RuntimeError):
            die(f"commit failed, nothing recorded: {err}")
        raise


def events(d):
    out = []
    for p in sorted(d.iterdir()) if d.is_dir() else []:
        m = EVENT.match(p.name)
        if m:
            fm, body = front_matter(p)
            out.append(dict(fm, n=int(m.group(1)), kind=m.group(2), body=body, path=p))
    return out


def clean(value):
    value = str(value)
    if "\n" in value or "\r" in value:
        die("field values may not contain line breaks")
    return value


def add_event(d, kind, fields, body, message, also=()):
    """Write the next event in d and commit it, with the new files in `also`;
    the caller holds the lock."""
    evs = events(d)
    n = (evs[-1]["n"] if evs else 0) + 1
    path = d / f"{n:04d}-{kind}.md"
    fields = dict(fields, event=kind, date=date.today().isoformat())
    text = "---\n" + "".join(f"{k}: {clean(v)}\n" for k, v in fields.items()) + "---\n"
    if body:
        text += "\n" + body.strip() + "\n"
    new_dir = [] if d.exists() else [d]
    d.mkdir(parents=True, exist_ok=True)
    with open(path, "x") as f:
        f.write(text)
    record(message, add=[path, *also], created=[path, *also, *new_dir])
    return path


# --- roles ------------------------------------------------------------------

def role_info(role):
    holder, gen, sessions = None, 0, []
    for e in events(ROLES / role):
        if e["kind"] == "take":
            holder, gen, sessions = e["by"], gen + 1, [e.get("session_id")]
        elif e["kind"] == "resume":
            sessions.append(e.get("session_id"))
        elif e["kind"] == "leave":
            holder, sessions = None, []
    return holder, gen, sessions


def role_state(role):
    return role_info(role)[:2]


def role_name(role, gen):
    return f"integrator-{gen}"


def tid(number):
    """A task's ID as people read it: T0007.2."""
    return "T" + number


# --- tasks ------------------------------------------------------------------

def key(number):
    return tuple(int(x) for x in number.split("."))


def all_tasks():
    found = []
    for place in PLACES:
        base = TASKS / place
        for d in base.iterdir() if base.is_dir() else []:
            m = TASK_DIR.match(d.name)
            if m and d.is_dir():
                found.append((place, m.group(1), d))
    return sorted(found, key=lambda t: key(t[1]))


def normalize(number):
    parts = number.split(".")
    return ".".join([parts[0].zfill(4)] + parts[1:])


def find_task(ref):
    """A task by ID (T0007.2, 0007.2, 7.2), full name (T0007.2-slug), or slug;
    `designer` names the root design task T0000."""
    tasks = all_tasks()
    if ref == "designer":
        ref = ROOT
    m = re.fullmatch(r"[Tt]?(\d+(?:\.\d+)*)(?:-([a-z0-9-]+))?", ref)
    if m:
        number, slug = normalize(m.group(1)), m.group(2)
        hits = [t for t in tasks if t[1] == number]
        if hits and slug and hits[0][2].name != f"T{number}-{slug}":
            die(f"task {tid(number)} is {hits[0][2].name}, not {ref}")
    else:
        hits = [t for t in tasks if t[2].name.split("-", 1)[1] == ref]
        if len(hits) > 1:
            unfinished = [t for t in hits if t[0] == "open"]
            if len(unfinished) == 1:
                hits = unfinished
            else:
                die(f"several tasks are named {ref}: " + ", ".join(tid(t[1]) for t in hits)
                    + "; use the ID")
    if not hits:
        die(f"task {ref} not found")
    return hits[0]


def parse_ids(text):
    """Task numbers from a list of IDs as written in a charter: T0007, T0007.1."""
    out = []
    for x in text.split(","):
        m = re.fullmatch(r"\s*[Tt]?(\d+(?:\.\d+)*)(?:-[a-z0-9-]+)?\s*", x)
        if m:
            out.append(normalize(m.group(1)))
        elif x.strip():
            out.append(x.strip())   # a slug; `ready` and `amend` refuse it unresolved
    return out


def raw_info(place, d):
    charter = front_matter(d / "charter.md")[0] if (d / "charter.md").exists() else {}
    number = TASK_DIR.match(d.name).group(1)
    info = dict(number=number, slug=d.name.split("-", 1)[1], dir=d, place=place,
                kind=charter.get("kind", "track"),
                depends=parse_ids(charter.get("depends", "")),
                state="ready" if number == ROOT else "draft", holder=None, last_holder=None,
                takes=0, sessions=[],
                leave_request=None, done=None, amended=[])
    for e in events(d):
        k = e["kind"]
        if k == "release":
            info["state"] = "ready"
        elif k == "amend":
            if "depends" in e:
                info["depends"] = parse_ids(e["depends"])
            if info["holder"]:
                info["amended"].append(e["path"].name)
        elif k == "take":
            info.update(state="held", holder=e["by"], leave_request=None, done=None, amended=[],
                        sessions=[e.get("session_id")])
            info["takes"] += 1
        elif k == "resume":
            info["sessions"].append(e.get("session_id"))
        elif k == "leave-request":
            info["leave_request"] = e
        elif k == "leave":
            info.update(state="ready", holder=None, leave_request=None, done=None, sessions=[])
        elif k == "done":
            info["done"] = e
        elif k == "reopen":
            info["done"] = None
        elif k in ("close", "cancel"):
            info.update(state="closed" if k == "close" else "cancelled",
                        last_holder=info["holder"], holder=None, leave_request=None,
                        sessions=[])
    return info


def infos():
    """All tasks; a ready task whose dependencies are not all closed is blocked."""
    out = [raw_info(p, d) for p, _, d in all_tasks()]
    states = {i["number"]: i["state"] for i in out}
    for i in out:
        if i["state"] == "ready" and i["number"] != ROOT and any(states.get(dep) != "closed" for dep in i["depends"]):
            i["state"] = "blocked"
            i["blocked_by"] = [dep for dep in i["depends"] if states.get(dep) != "closed"]
    return out


def task_info(d):
    for i in infos():
        if i["dir"] == d:
            return i
    die(f"task directory {d.name} not found")


def get(ref):
    return task_info(find_task(ref)[2])


def check_depends(number, refs):
    """Normalize, deduplicate, and validate dependencies of task `number`."""
    deps = []
    for ref in refs:
        n = get(ref)["number"] if not isinstance(ref, dict) else ref["number"]
        if n not in deps:
            deps.append(n)
    need(number != ROOT or not deps, f"task {tid(ROOT)}, the root design, has no dependencies")
    tasks = {i["number"]: i for i in infos()}
    for n in deps:
        need(n != ROOT, f"no task depends on {tid(ROOT)}, the root design, which never closes")
        need(n != number, f"task {tid(number)} cannot depend on itself")
        need(not number.startswith(n + "."), f"task {tid(number)} cannot depend on {tid(n)}, which contains it")
        need(not n.startswith(number + "."), f"task {tid(number)} cannot depend on its own subtask {tid(n)}")
        need(tasks[n]["state"] != "cancelled", f"dependency {tid(n)} is cancelled")
    graph = {k: list(v["depends"]) for k, v in tasks.items()}
    graph[number] = deps
    seen, stack = set(), list(deps)
    while stack:
        n = stack.pop()
        need(n != number, f"dependencies of task {tid(number)} would form a cycle through {tid(n)}")
        if n not in seen:
            seen.add(n)
            stack.extend(graph.get(n, []))
    return deps


def holder_name(info):
    if info["number"] == ROOT:
        return f"designer-g{info['takes'] + 1}"
    base = f"{info['kind']}-{tid(info['number'])}"
    return base if info["takes"] == 0 else f"{base}-{info['takes'] + 1}"


def level(number):
    return 0 if number == ROOT else len(number.split("."))


def supervisor(number):
    """The holder name supervising task `number`: "user" for the root design
    task, the holder of the parent design task otherwise, or None if vacant."""
    if number == ROOT:
        return "user"
    parent = ROOT if "." not in number else number.rsplit(".", 1)[0]
    return get(parent)["holder"]


def held_by(name):
    if role_state("integrator")[0] == name:
        return ("role", "integrator")
    for i in infos():
        if i["holder"] == name:
            return ("task", i)
    return None


def session_id():
    """This session's ID, if the agent tool gives one."""
    return (os.environ.get("PTT_SESSION_ID") or os.environ.get("CLAUDE_CODE_SESSION_ID")
            or os.environ.get("CODEX_THREAD_ID") or os.environ.get("CODEX_SESSION_ID") or None)


def read_hook_session():
    """Use the hook event's identity even when its process has no tool environment."""
    try:
        event = json.load(sys.stdin)
    except ValueError:
        die("inbox --hook: expected a UserPromptSubmit JSON event")
    need(isinstance(event, dict) and event.get("hook_event_name") == "UserPromptSubmit",
         "inbox --hook: expected a UserPromptSubmit event")
    sid = event.get("session_id")
    need(isinstance(sid, str) and bool(sid.strip()) and "\n" not in sid and "\r" not in sid,
         "inbox --hook: expected a nonempty session_id string")
    return sid


def holdings():
    """(holder name, directory of its events, sessions bound since the take,
    the last one being the current binding) for every current holder."""
    out = []
    holder, _, sessions = role_info("integrator")
    if holder:
        out.append((holder, ROLES / "integrator", sessions))
    out += [(i["holder"], i["dir"], i["sessions"]) for i in infos() if i["holder"]]
    return out


def writes_by(name):
    """git log options selecting commits written by holder NAME."""
    return ["-E", "--grep", rf"by {re.escape(name)}([^A-Za-z0-9.-]|$)"]


def last_write(name):
    """The time of NAME's last commit in the records, or None."""
    out = git("log", "-1", "--format=%ct", *writes_by(name), check=False).stdout.strip()
    return int(out) if out else None


def ago(t):
    if t is None:
        return "no write found"
    d = max(0, time.time() - t)
    for unit, size in (("days", 86400), ("h", 3600), ("min", 60)):
        if d >= size:
            return f"{int(d // size)} {unit} ago"
    return "just now"


def handover_dir():
    return git_dir() / "ptt-handover"


def handover(name, binding):
    """NAME's handover marker if it is still valid, else None (and it is
    removed). It lapses by events, never by age: when the holder writes again
    after it, its binding moves, or its hold ends."""
    f = handover_dir() / name
    if not f.exists():
        return None
    m = dict(line.split("=", 1) for line in f.read_text().splitlines() if "=" in line)
    valid = (binding is not None and m.get("session") == binding
             and git("cat-file", "-e", m.get("commit", "") + "^{commit}", check=False).returncode == 0
             and not git("log", "-1", "--format=%H", *writes_by(name),
                         f"{m['commit']}..HEAD", check=False).stdout.strip())
    if not valid:
        f.unlink(missing_ok=True)
        return None
    return m


def bound_here():
    """The holder bound to this session, or None."""
    sid = session_id()
    for name, _, sessions in holdings():
        if sid and sessions[-1] == sid:
            return name
    return None


def check_session(name):
    """Refuse a write from this session that would act as a holder bound to
    another session, or that comes from a session its holder has left by a
    resume elsewhere."""
    sid = session_id()
    if not sid:
        return
    for holder, _, sessions in holdings():
        if sid in sessions[:-1] and sessions[-1] != sid:
            die(f"this session was {holder}, which has since continued in another session "
                f"(ptt resume); this session must no longer write. If it should be {holder} "
                f"again, run `ptt resume {holder}` here (/ptt-resume {holder})")
        if holder == name and sessions[-1] and sessions[-1] != sid:
            die(f"{name} is bound to another session; if this session continues {name} "
                f"(after /clear), run `ptt resume {name}` first (/ptt-resume {name})")


def subtree(name):
    """Tasks below `name`, the holder of a design task: every task for the
    root designer, the descendants of its design task for a sub-designer."""
    held = held_by(name)
    if not (held and held[0] == "task" and held[1]["kind"] == "design"):
        return []
    n = held[1]["number"]
    if n == ROOT:
        return [i for i in infos() if i["number"] != ROOT]
    return [i for i in infos() if i["number"].startswith(n + ".")]


def last_record(i):
    out = git("log", "-1", "--format=%ct", "--", str(i["dir"].relative_to(REC)),
              check=False).stdout.strip()
    return int(out) if out else None


def unclear(tasks):
    """Lines describing tasks whose status is unclear."""
    out, now = [], time.time()
    for i in tasks:
        if i["holder"] is None:
            continue
        if i["leave_request"]:
            out.append(f"task {tid(i['number'])}: {i['holder']} asks to leave")
        if i["done"]:
            out.append(f"task {tid(i['number'])}: {i['holder']} reports done")
        last = last_record(i)
        if last and now - last > STALE_DAYS * 86400:
            out.append(f"task {tid(i['number'])}: no record from {i['holder']} for "
                       f"{int((now - last) / 86400)} days")
    return out


def must_supervise(name, number):
    sup = supervisor(number)
    if name == "user" or sup == name:
        return
    die(f"{name} does not supervise task {tid(number)} (its supervisor is "
        f"{sup or 'vacant; the user acts with --as user'})")


def must_be_clear(name, tasks=None):
    lines = unclear(subtree(name) if tasks is None else tasks)
    if lines:
        die(f"{name}: something below is unclear; settle it first: " + "; ".join(lines))


def need(cond, msg):
    if not cond:
        die(msg)


# --- commands -----------------------------------------------------------------

def bind():
    """The session field of a take or resume event; refuses a session that
    already holds something."""
    here = bound_here()
    need(not here, f"this session is {here}; one session holds one role or task (to work on "
         "another, use a fresh session, or leave first)")
    sid = session_id()
    return dict(session_id=sid) if sid else {}


def bind_note(name):
    if not session_id():
        note(f"no session ID (only some agent tools give one): {name} is not bound to this "
             "session, and its writes are not checked")


def resume_choice():
    """The holder a session continues as when the user names none: the one
    with a valid handover marker, or None after listing the holders."""
    held = holdings()
    sid = session_id()
    marked = [(n, handover(n, s[-1] if s else None)) for n, _, s in held]
    marked = [(n, m) for n, m in marked if m]
    if len(marked) == 1:
        name, m = marked[0]
        print(f"{name} left a handover {ago(float(m['time']))}; continuing it")
        return name
    rows = []
    for n, _, s in held:
        if sid and s and s[-1] == sid:
            continue
        m = dict(marked).get(n)
        t = last_write(n)
        busy = t is not None and time.time() - t < 600 and not m
        rows.append((0 if m else 1, -(t or 0), n,
                     f"handover left {ago(float(m['time']))}" if m else
                     f"last write {ago(t)}" + ("; may still be working" if busy else "")))
    if not rows:
        print("no holder to continue; `ptt who` lists the holders")
        return None
    print("Which holder does this session continue as? (ptt resume NAME)")
    for k, (_, _, n, text) in enumerate(sorted(rows), 1):
        print(f"{k}. {n:16} {text}")
    return None


def cmd_handover(a):
    """Leave a handover marker for NAME, so that a fresh session continues
    it with `ptt resume` and no name. Only the session bound to NAME does."""
    hits = [h for h in holdings() if h[0] == a.name]
    need(hits, f"{a.name} holds nothing")
    sessions = hits[0][2]
    sid = session_id()
    need(not sid or not sessions or sessions[-1] in (sid, None),
         f"{a.name} is bound to another session; only that session leaves its handover")
    handover_dir().mkdir(exist_ok=True)
    (handover_dir() / a.name).write_text(
        f"session={(sessions[-1] if sessions else '') or ''}\n"
        f"commit={git('rev-parse', 'HEAD').stdout.strip()}\ntime={time.time()}\n")
    print(f"handover left: a fresh session continues {a.name} with `ptt resume` "
          "(/ptt-resume) and no name")


def cmd_resume(a):
    if not a.name:
        a.name = resume_choice()
        if not a.name:
            return
    hits = [h for h in holdings() if h[0] == a.name]
    need(hits, f"{a.name} holds nothing; nothing to continue (`ptt who` lists the holders)")
    _, d, sessions = hits[0]
    sid = session_id()
    if sid and sessions[-1] == sid:
        print(f"this session is already {a.name}")
        return
    fields = dict(by=a.name, **bind())
    what = f"role {d.name}" if d.parent == ROLES else f"task {tid(TASK_DIR.match(d.name).group(1))}"
    add_event(d, "resume", fields, "", f"{what}: {a.name} continues in a new session")
    (handover_dir() / a.name).unlink(missing_ok=True)
    print(f"this session is {a.name}")
    bind_note(a.name)
    if sid:
        note(f"the session that was {a.name} before must no longer be used: its writes are "
             "refused from now on")


def cmd_take(a):
    if a.what == "integrator":
        holder, gen = role_state(a.what)
        need(not holder, f"{a.what} is held by {holder}; it must leave first "
             "(or the user frees it)")
        name = role_name(a.what, gen + 1)
        add_event(ROLES / a.what, "take", dict(by=name, generation=gen + 1, **bind()), "",
                  f"role {a.what}: taken by {name}")
        print(name)
        bind_note(name)
        return
    i = get(a.what)
    detail = (f" (held by {i['holder']})" if i["holder"] else "") + \
             (f" (waits for {', '.join(map(tid, i['blocked_by']))})" if i.get("blocked_by") else "")
    need(i["state"] == "ready", f"task {tid(i['number'])} is {i['state']}{detail}; cannot take it")
    name = holder_name(i)
    status = i["dir"] / "status.md"
    extra = []
    if not status.exists():
        status.write_text(f"# Status of task {tid(i['number'])}\n\nWritten by the holder: what is "
                          "done (request numbers and merge commits), what is open, where it "
                          "stands. No review states.\n")
        extra = [status]
    add_event(i["dir"], "take", dict(by=name, **bind()), "",
              f"task {tid(i['number'])}: taken by {name}", also=extra)
    print(name)
    bind_note(name)
    if i["number"] == ROOT:
        unfilled = [f for f in ("charter.md", "status.md")
                    if "{{" in (i["dir"] / f).read_text()]
        if unfilled:
            note(f"{tid(ROOT)} is not filled in yet ({' and '.join(unfilled)} still have "
                 "{{...}} placeholders); the designer's first step is to fill them in place "
                 "(the first fill-in is a direct edit, not an amendment)")
        if not role_state("integrator")[0]:
            note("no session holds the integrator role; requests wait until one takes it")


def cmd_leave(a):
    held = held_by(a.name)
    need(held, f"{a.name} holds nothing")
    must_be_clear(a.name)
    if held[0] == "task" and held[1]["number"] == ROOT:
        i = held[1]
        add_event(i["dir"], "leave", dict(by=a.name), a.status or "",
                  f"task {tid(ROOT)}: {a.name} leaves the root design")
        print(f"{a.name} left the root design; the next `ptt take designer` is "
              f"designer-g{i['takes'] + 1}")
        return
    if held[0] == "role":
        role = held[1]
        if role == "integrator":
            pending = []
            for d in sorted((REC / "pr" / "open").glob("*")):
                msgs = sorted(d.glob("[0-9][0-9][0-9][0-9]-*.md"))
                if msgs:
                    fm = front_matter(msgs[-1])[0]
                    if fm.get("kind") == "decision" and fm.get("decision") != "changes-requested":
                        pending.append(d.name[:6])
            need(not pending, "integrator cannot leave: decisions not carried out for "
                 "request(s) " + ", ".join(pending))
        add_event(ROLES / role, "leave", dict(by=a.name), a.status or "",
                  f"role {role}: {a.name} leaves")
        print(f"{a.name} left the {role} role")
        return
    i = held[1]
    need(not i["leave_request"], f"{a.name} already asked to leave task {tid(i['number'])}")
    need(not i["done"], f"task {tid(i['number'])} is reported done; its supervisor closes or reopens it")
    add_event(i["dir"], "leave-request", dict(by=a.name), a.status or "",
              f"task {tid(i['number'])}: {a.name} asks to leave")
    sup = supervisor(i["number"])
    print(f"asked to leave task {tid(i['number'])}; "
          + (f"{sup} must approve" if sup else "the supervisor is vacant; the user approves")
          + f" (ptt approve-leave {tid(i['number'])})")


def cmd_approve_leave(a):
    i = get(a.task)
    must_supervise(a.as_, i["number"])
    need(i["holder"] and i["leave_request"], f"nobody asked to leave task {tid(i['number'])}")
    if i["kind"] == "design":
        must_be_clear(i["holder"])
    add_event(i["dir"], "leave", dict(by=i["holder"], approved_by=a.as_), "",
              f"task {tid(i['number'])}: {i['holder']} leaves, approved by {a.as_}")
    print(f"task {tid(i['number'])} is ready again")


def cmd_free(a):
    if a.what == "integrator":
        need(a.as_ == "user", "only the user frees a role (--as user)")
        holder, _ = role_state(a.what)
        need(holder, f"{a.what} is not held")
        add_event(ROLES / a.what, "leave", dict(by=holder, freed_by="user"), a.reason,
                  f"role {a.what}: {holder} freed by the user")
        print(f"{a.what} is free")
        return
    i = get(a.what)
    must_supervise(a.as_, i["number"])
    need(i["state"] == "held", f"task {tid(i['number'])} is not held")
    need(not i["done"], f"task {tid(i['number'])} is reported done; close or reopen it first")
    last = last_record(i)
    silent = last is not None and time.time() - last > STALE_DAYS * 86400
    need(silent or a.force, f"{i['holder']} has a record from the last {STALE_DAYS:g} days; "
         "it may still be working. Ask it to leave (approval), or use --force if you know "
         "it is gone")
    add_event(i["dir"], "leave", dict(by=i["holder"], freed_by=a.as_, forced=bool(a.force)),
              a.reason,
              f"task {tid(i['number'])}: {i['holder']} freed by {a.as_}")
    print(f"task {tid(i['number'])} is ready again; its status.md shows where it stood")


def cmd_mktask(a):
    held = held_by(a.as_)
    if not (held and held[0] == "task" and held[1]["kind"] == "design"):
        die(f"{a.as_} is not a designer; only a designer makes tasks")
    prefix = "" if held[1]["number"] == ROOT else held[1]["number"] + "."
    need(re.fullmatch(r"[a-z][a-z0-9-]*", a.slug),
         "slug: starts with a letter; lower-case letters, digits, hyphens")
    need(a.slug not in ("designer", "integrator") and not re.match(r"t\d", a.slug),
         "slug: `designer`, `integrator`, and t<digit>... are reserved for roles and task IDs")
    need(a.kind in KINDS, f"kind must be one of {', '.join(KINDS)}")
    need(not [t for t in all_tasks() if t[0] == "open" and t[2].name.split("-", 1)[1] == a.slug],
         f"an unfinished task is already named {a.slug}")
    siblings = [n for _, n, _ in all_tasks()
                if n.startswith(prefix) and "." not in n[len(prefix):] and n != ROOT]
    last = max((int(n[len(prefix):]) for n in siblings), default=0)
    number = f"{prefix}{last + 1}" if prefix else f"{last + 1:04d}"
    depends = check_depends(number, [x.strip() for x in (a.depends or "").split(",") if x.strip()])
    d = TASKS / "open" / f"{tid(number)}-{a.slug}"
    d.mkdir(parents=True)        # fails if it exists: the lock makes this a bug
    template = TASKS / "charter-template.md"
    body = template.read_text() if template.exists() else "# Task {{NUMBER}}: {{TITLE}}\n"
    text = (f"---\ntask: {tid(number)}\nkind: {a.kind}\ndepends: {', '.join(map(tid, depends))}\n"
            f"designer: {a.as_}\ndate: {date.today().isoformat()}\n---\n\n"
            + body.replace("{{TITLE}}", a.slug.replace("-", " ").capitalize())
                  .replace("{{NUMBER}}", tid(number)))
    (d / "charter.md").write_text(text)
    record(f"task {tid(number)}: draft by {a.as_}", add=[d / "charter.md"], created=[d])
    print(d / "charter.md")


def cmd_ready(a):
    i = get(a.task)
    must_supervise(a.as_, i["number"])
    need(i["state"] == "draft", f"task {tid(i['number'])} is {i['state']}, not a draft")
    charter = (i["dir"] / "charter.md").read_text()
    need("{{" not in charter, f"the charter of task {tid(i['number'])} still has {{{{...}}}} "
         "placeholders; fill them in first")
    need(i["kind"] in KINDS, f"kind '{i['kind']}' must be one of {', '.join(KINDS)}")
    deps = check_depends(i["number"], i["depends"])
    need(deps == i["depends"], "write the charter's `depends:` as task IDs: "
         + ", ".join(map(tid, deps)))
    record(f"task {tid(i['number'])}: charter as released", add=[i["dir"] / "charter.md"])
    add_event(i["dir"], "release", dict(by=a.as_), "", f"task {tid(i['number'])}: released by {a.as_}")
    print(f"task {tid(i['number'])} is ready to take")


def cmd_amend(a):
    i = get(a.task)
    must_supervise(a.as_, i["number"])
    need(i["state"] not in ("draft", "closed", "cancelled"),
         f"task {tid(i['number'])} is {i['state']}: a draft is edited directly, a finished task "
         "is not amended")
    fields = dict(by=a.as_)
    if a.depends is not None:
        fields["depends"] = ", ".join(map(tid, check_depends(
            i["number"], [x.strip() for x in a.depends.split(",") if x.strip()])))
    add_event(i["dir"], "amend", fields, a.text, f"task {tid(i['number'])}: amended by {a.as_}")
    print("amended; tell the holder, if any")


def cmd_done(a):
    i = get(a.task)
    not_root(i)
    need(i["state"] == "held" and i["holder"] == a.as_, f"{a.as_} does not hold task {tid(i['number'])}")
    need(not i["done"], f"task {tid(i['number'])} is already reported done")
    need(not i["leave_request"], f"{a.as_} asked to leave task {tid(i['number'])}; settle that first")
    add_event(i["dir"], "done", dict(by=a.as_, requests=a.requests or ""), a.text or "",
              f"task {tid(i['number'])}: {a.as_} reports done")
    print(f"reported; {supervisor(i['number']) or 'the user (supervisor vacant)'} "
          "closes or reopens")


def finish(i, kind, place, fields, body, message):
    """Write the closing event and move the task to `place`, as one commit."""
    dirty = git("status", "--porcelain", "--untracked-files=all", "--",
                str(i["dir"].relative_to(REC))).stdout.strip()
    need(not dirty, f"{i['dir'].relative_to(REC)} has uncommitted changes; commit them first "
         "(ptt record):\n" + dirty)
    evs = events(i["dir"])
    event = i["dir"] / f"{(evs[-1]['n'] if evs else 0) + 1:04d}-{kind}.md"
    fields = dict(fields, event=kind, date=date.today().isoformat())
    text = "---\n" + "".join(f"{k}: {clean(v)}\n" for k, v in fields.items()) + "---\n"
    if body:
        text += "\n" + body.strip() + "\n"
    target = TASKS / place / i["dir"].name
    target.parent.mkdir(parents=True, exist_ok=True)
    with open(event, "x") as f:
        f.write(text)
    os.rename(i["dir"], target)

    def undo():
        os.rename(target, i["dir"])
        (i["dir"] / event.name).unlink(missing_ok=True)
    record(message, add=[target], remove=[i["dir"]], undo=undo, shown=[target / event.name])


def not_root(i):
    need(i["number"] != ROOT, f"task {tid(ROOT)} is the root design; it is never done, "
         "closed, or cancelled (its holder leaves instead)")


def cmd_close(a):
    i = get(a.task)
    not_root(i)
    must_supervise(a.as_, i["number"])
    need(i["state"] == "held" and i["done"], f"task {tid(i['number'])} has no done report to accept")
    open_below = [x["number"] for x in infos() if x["number"].startswith(i["number"] + ".")
                  and x["state"] not in ("closed", "cancelled")]
    need(not open_below, "its subtasks are not closed: " + ", ".join(map(tid, open_below)))
    finish(i, "close", "done", dict(by=a.as_), "", f"task {tid(i['number'])}: closed by {a.as_}")
    print(f"task {tid(i['number'])} closed; {i['holder']} holds nothing now")


def cmd_reopen(a):
    i = get(a.task)
    not_root(i)
    must_supervise(a.as_, i["number"])
    need(i["state"] == "held" and i["done"], f"task {tid(i['number'])} has no done report to reopen")
    add_event(i["dir"], "reopen", dict(by=a.as_), a.reason,
              f"task {tid(i['number'])}: reopened by {a.as_}")
    print(f"task {tid(i['number'])} reopened; {i['holder']} continues")


def cmd_cancel(a):
    i = get(a.task)
    not_root(i)
    must_supervise(a.as_, i["number"])
    need(i["state"] in ("draft", "ready", "blocked"),
         f"task {tid(i['number'])} is {i['state']}" + (f" by {i['holder']}; free it first"
                                                if i["holder"] else ""))
    below = [x["number"] for x in infos() if x["number"].startswith(i["number"] + ".")
             and x["state"] not in ("closed", "cancelled")]
    need(not below, "its subtasks are not finished: " + ", ".join(map(tid, below)))
    dependents = [x["number"] for x in infos() if i["number"] in x["depends"]
                  and x["state"] not in ("closed", "cancelled")]
    need(not dependents, f"tasks {', '.join(map(tid, dependents))} depend on it; amend or cancel them first")
    finish(i, "cancel", "cancelled", dict(by=a.as_), a.reason,
           f"task {tid(i['number'])}: cancelled by {a.as_}")
    print(f"task {tid(i['number'])} cancelled")


def cmd_pr_move(a):
    number = a.request.lower().removeprefix("pr-").zfill(6)
    hits = sorted((REC / "pr" / "open").glob(f"{number}-*"))
    need(hits, f"request {number} is not in pr/open")
    src = hits[0]
    dirty = git("status", "--porcelain", "--untracked-files=all", "--",
                str(src.relative_to(REC))).stdout.strip()
    need(not dirty, f"{src.relative_to(REC)} has unrecorded changes; record them first:\n" + dirty)
    target = REC / "pr" / a.to / src.name
    target.parent.mkdir(parents=True, exist_ok=True)
    os.rename(src, target)
    record(a.message, add=[target], remove=[src], undo=lambda: os.rename(target, src),
           shown=[target])
    print(f"request {number} moved to pr/{a.to}")


def in_head(path):
    return git("cat-file", "-e", f"HEAD:{path.relative_to(REC)}", check=False).returncode == 0


def cmd_record(a):
    paths = []
    for x in a.paths:
        p = (Path.cwd() / x).resolve() if not Path(x).is_absolute() else Path(x).resolve()
        need(p == REC or REC in p.parents, f"{x} is outside the records repository")
        paths.append(p)
    need(paths, "name the paths to record")
    new_requests = set()
    for p in paths:
        r = p.relative_to(REC).parts
        if len(r) >= 3 and r[:2] == ("pr", "open") and not in_head(REC / "pr" / "open" / r[2]):
            new_requests.add(r[2])
        if len(r) < 3 or r[0] not in ("tasks", "pr") or r[1] not in PLACES + ("merged", "closed"):
            continue
        target = REC / r[0] / r[1] / r[2]
        if in_head(target):
            continue                  # an existing task or request: a normal write
        number = r[2].split("-")[0]
        moved = [d for d in (REC / r[0]).glob(f"*/{number}-*")
                 if d.is_dir() and d != target and in_head(d)]
        need(not moved, f"{p.relative_to(REC)}: {number} is now {moved[0].relative_to(REC)} "
             "(moved by a decision); write there instead, and remove this stray copy" if moved
             else "")
    print("recorded" if record(a.message, add=paths) else "nothing to record")
    if new_requests and not role_state("integrator")[0]:
        note(f"no session holds the integrator role: request {', '.join(sorted(new_requests))} "
             "waits until one takes it (/ptt-take integrator, in a fresh session)")


def note(text):
    """A notice for the user, on standard error so that standard output stays
    what scripts read (a holder name, a path)."""
    print(f"note: {text}", file=sys.stderr)


def cmd_tasks(a):
    def waiting(i):
        if i["holder"] is None:
            return "waits for " + ", ".join(map(tid, i["blocked_by"])) if i.get("blocked_by") else ""
        return "leave asked" if i["leave_request"] else "done reported" if i["done"] else ""
    rows = [(tid(i["number"]), i["kind"], i["state"],
             i["holder"] or (f"({i['last_holder']})" if i["last_holder"] else "-"),
             waiting(i), i["slug"]) for i in infos()
            if a.all or i["state"] not in ("closed", "cancelled")]
    loose = []
    for line in git("status", "--porcelain", "--untracked-files=all", "--", "tasks", "roles",
                    check=False).stdout.splitlines():
        loose += line[3:].split(" -> ")
    if loose:
        print("warning: uncommitted in the records repository (an interrupted command, or a "
              "write not yet recorded):")
        for path in loose:
            print(f"  {path}")
        print("  inspect with `git -C <records> status`; to keep the change, record these "
              "paths with `ptt record -m <message> <paths>`; to drop it, run "
              "`git -C <records> reset -q -- <paths>` and `git -C <records> checkout -- <paths>`, "
              "and delete what is untracked (see flows/tasks.md, Recovery)")
    if not rows:
        print("no tasks")
        return
    header = ("task", "kind", "state", "holder", "waiting", "name")
    w = [max(len(str(r[k])) for r in rows + [header]) for k in range(len(header))]
    for r in [header] + rows:
        print("  ".join(str(c).ljust(x) for c, x in zip(r, w)).rstrip())


def cmd_show(a):
    d = find_task(a.task)[2]
    for p in [d / "charter.md", d / "status.md"] + [e["path"] for e in events(d)]:
        if p.exists():
            print(f"\n==> {p.name} <==\n{p.read_text()}", end="")


def cmd_who(a):
    print(f"{'integrator':11} {role_state('integrator')[0] or '(free)'}")
    print(f"{'designer':11} {get(ROOT)['holder'] or '(free)'}")
    for i in infos():
        if i["holder"] and i["number"] != ROOT:
            print(f"task {tid(i['number']):10} {i['holder']}  ({i['kind']}, {i['slug']})")


def cmd_whoami(a):
    if not a.name:
        a.name = bound_here()
        if not a.name:
            print("this session holds nothing" + ("" if session_id() else
                  " that ptt can see (no session ID); name the holder: ptt whoami NAME"))
            return
    held = held_by(a.name)
    if not held:
        print(f"{a.name} holds nothing; take a role or task with `ptt take`")
        return
    if held[0] == "role":
        print(f"{a.name}: {held[1]}; supervisor: the user")
    else:
        i = held[1]
        sup = supervisor(i["number"])
        print(f"{a.name}: {i['kind']} task {tid(i['number'])}-{i['slug']}, level "
              f"{level(i['number'])}, generation {i['takes']}; supervisor "
              + (sup or "vacant (the user acts until it is taken)"))
        print(f"charter: {(i['dir'] / 'charter.md').relative_to(REC.parent)}")
    sessions = [h[2] for h in holdings() if h[0] == a.name][0]
    sid = session_id()
    if sessions[-1]:
        print("session: " + ("this one" if sessions[-1] == sid else
                             f"another one; continue here with `ptt resume {a.name}`"))


def tree(rev):
    """Records under tasks/, pr/, handoff/notes/ at `rev`: {(area, dir, file):
    (place, blob)}, so that a task or request moved between places keeps its key."""
    out = {}
    for line in git("ls-tree", "-r", rev, "--", "tasks", "pr", "handoff/notes",
                    check=False).stdout.splitlines():
        meta, path = line.split("\t", 1)
        parts = path.split("/")
        if parts[0] in ("tasks", "pr") and len(parts) == 4:
            out[(parts[0], parts[2], parts[3])] = (parts[1], meta.split()[2])
        elif parts[:2] == ["handoff", "notes"] and len(parts) == 3 and parts[2] != ".gitkeep":
            out[("notes", "", parts[2])] = ("", meta.split()[2])
    return out


def inbox_base(name, d):
    """The records commit NAME last looked at, or else its take."""
    mark = git_dir() / "ptt-inbox" / name
    if mark.exists():
        sha = mark.read_text().strip()
        if git("cat-file", "-e", f"{sha}^{{commit}}", check=False).returncode == 0:
            return sha
    takes = [e for e in events(d) if e["kind"] == "take"]
    rel = str(takes[-1]["path"].relative_to(REC)) if takes else "."
    return git("log", "-1", "--format=%H", "--", rel, check=False).stdout.strip() or None


def news(name, held, base):
    """Lines for what changed since `base` that concerns NAME."""
    if not base:
        return []
    old, new = tree(base), tree("HEAD")
    changed = {k: v for k, v in new.items() if old.get(k, (None, None))[1] != v[1]}
    moved = {k: v for k, v in new.items() if k in old and old[k][0] != v[0]}

    def sha(area, d, f):
        place = new[(area, d, f)][0]
        path = f"{area}/{place}/{d}/{f}" if area != "notes" else f"handoff/notes/{f}"
        return git("log", "-1", "--format=%h", f"{base}..HEAD", "--", path,
                   check=False).stdout.strip()
    out = []
    mine = held[1] if held[0] == "task" else None
    below = {i["dir"].name: i for i in subtree(name)}
    for (area, d, f), (place, _) in sorted(changed.items()):
        if area == "tasks" and d in below:
            i = below[d]
            if f == "status.md":
                out.append(f"read {tid(i['number'])} status.md: updated by its holder "
                           f"({sha(area, d, f)})")
            elif EVENT.match(f) and EVENT.match(f).group(2) in ("done", "leave-request") \
                    and i["holder"] and (i["done"] if "done" in f else i["leave_request"]):
                kind = "a done report" if "done" in f else "a request to leave"
                out.append(f"{tid(i['number'])}: {kind} waits on you ({sha(area, d, f)})")
        elif area == "tasks" and mine and d == mine["dir"].name and EVENT.match(f):
            kind = EVENT.match(f).group(2)
            if kind in ("amend", "reopen"):
                out.append(f"your task {tid(mine['number'])}: {kind} event {f}; read it with "
                           f"`ptt show {tid(mine['number'])}` ({sha(area, d, f)})")
        elif area == "notes" and mine and mine["number"] == ROOT:
            out.append(f"read handoff/notes/{f}: a note to the designer ({sha(area, d, f)})")
        elif area == "pr" and EVENT.match(f):
            msg = REC / "pr" / place / d / f
            first = REC / "pr" / place / d / "0001-request.md"
            if not msg.exists() or not first.exists():
                continue
            fm = front_matter(msg)[0]
            writer = fm.get("session") or fm.get("recorded_by")
            requester = front_matter(first)[0].get("session")
            kind = fm.get("kind", f.split("-", 1)[1].removesuffix(".md"))
            if requester == name and writer != name:
                out.append(f"request {d[:6]}: new {kind} {f[:4]} ({sha(area, d, f)})")
            elif held == ("role", "integrator") and writer != name and kind in ("request", "reply"):
                out.append(f"request {d[:6]}: new {kind} {f[:4]}, waiting for review "
                           f"({sha(area, d, f)})")
    for (area, d, f), (place, _) in sorted(moved.items()):
        if area == "pr" and f == "0001-request.md" and \
                front_matter(REC / "pr" / place / d / f)[0].get("session") == name:
            out.append(f"request {d[:6]}: now {place}; record the outcome in your status")
    return out


def ended_holds():
    """Holds that someone else ended (a close, an approved leave, a freeing):
    dicts with the holder's name, its sessions, the ending event, and a line
    saying so. A holder's own leave is not listed; it ran the command."""
    out = []
    dirs = [("the integrator role", ROLES / "integrator")]
    dirs += [(tid(n), d) for _, n, d in all_tasks()]
    for what, d in dirs:
        name, sessions = None, []
        for e in events(d):
            k = e["kind"]
            if k == "take":
                name, sessions = e["by"], [e.get("session_id")]
            elif k == "resume":
                sessions.append(e.get("session_id"))
            elif k in ("leave", "close") and name:
                who = lambda f: "the user" if e.get(f) == "user" else e.get(f)
                if k == "close":
                    line = f"{what} was closed by {who('by')}"
                elif e.get("freed_by"):
                    line = f"{name} was freed from {what} by {who('freed_by')}"
                elif e.get("approved_by"):
                    line = f"{who('approved_by')} approved {name}'s leaving {what}"
                else:
                    line = None
                if line:
                    out.append(dict(name=name, sessions=sessions, path=e["path"], line=line))
                name, sessions = None, []
    return out


def ended_note(end, mark):
    """The notice that END's hold has ended, or None if the marker has it."""
    commit = end["commit"]
    if not commit or (mark and git("merge-base", "--is-ancestor", commit, mark,
                                    check=False).returncode == 0):
        return None
    return (f"{end['line']} (records {commit[:7]}): {end['name']} holds nothing now; "
            f"record nothing more as {end['name']}. This session may be cleared.")


def inbox_ended(name, quiet):
    """For a NAME that holds nothing, or the session last bound to a hold
    that ended: say once that it ended, and move the marker."""
    sid = session_id()
    ends = [e for e in ended_holds()
            if (e["name"] == name if name else sid and e["sessions"][-1] == sid)]
    if not ends:
        return False
    for e in ends:
        e["commit"], _, when = git("log", "-1", "--format=%H %ct", "--",
                                   str(e["path"].relative_to(REC)),
                                   check=False).stdout.strip().partition(" ")
        e["when"] = int(when or 0)
    end = max(ends, key=lambda e: e["when"])
    mark_file = git_dir() / "ptt-inbox" / end["name"]
    mark = mark_file.read_text().strip() if mark_file.exists() else None
    line = ended_note(end, mark)
    if line:
        print(f"ptt inbox for {end['name']}: {line}" if quiet else line)
    elif quiet:
        return True
    else:
        print(f"{end['line']}; {end['name']} holds nothing now")
    mark_file.parent.mkdir(exist_ok=True)
    mark_file.write_text(git("rev-parse", "HEAD").stdout.strip() + "\n")
    return True


def inbox_moved(quiet):
    """Tell a session, once, that its holder continues in another session."""
    sid = session_id()
    if not sid:
        return False
    for name, d, sessions in holdings():
        if sid in sessions[:-1] and sessions[-1] != sid:
            flag = git_dir() / "ptt-inbox" / f"moved-{sid}"
            if flag.exists():
                return False
            commit = git("log", "-1", "--format=%h", "--", str(d.relative_to(REC)),
                         check=False).stdout.strip()
            line = (f"{name} continues in another session (records {commit}): this session "
                    f"holds nothing now; record nothing more as {name}, and close it.")
            print(f"ptt inbox for {name}: {line}" if quiet else line)
            flag.parent.mkdir(exist_ok=True)
            flag.write_text(commit + "\n")
            return True
    return False


def cmd_inbox(a):
    name = a.name or bound_here()
    if not name:
        if inbox_moved(a.quiet):
            return
        if not inbox_ended(None, a.quiet) and not a.quiet:
            print("this session holds nothing" + ("" if session_id() else
                  " that ptt can see (no session ID); name the holder: ptt inbox NAME"))
        return
    held = held_by(name)
    if not held:
        if not inbox_ended(name, a.quiet) and not a.quiet:
            print(f"{name} holds nothing")
        return
    d = ROLES / held[1] if held[0] == "role" else held[1]["dir"]
    head = git("rev-parse", "HEAD").stdout.strip()
    new = news(name, held, inbox_base(name, d))
    waits = []
    if held[0] == "task":
        i = held[1]
        if i["leave_request"]:
            waits.append("your request to leave waits on your supervisor")
        if i["done"]:
            waits.append("your done report waits on your supervisor")
        for f in i["amended"]:
            waits.append(f"amended since your take: {f}; read it with `ptt show {tid(i['number'])}`")
    waits += unclear(subtree(name))
    if a.quiet:
        if new:
            print(f"ptt inbox for {name} (new in the records since it last looked):")
            for line in new:
                print(f"- {line}")
    else:
        print(f"{name}, new since you last looked:" if new else f"{name}: nothing new")
        for line in new:
            print(f"- {line}")
        for line in waits:
            print(f"waits on you: {line}")
    mark = git_dir() / "ptt-inbox" / name
    mark.parent.mkdir(exist_ok=True)
    mark.write_text(head + "\n")


MUTATING = {"take", "resume", "leave", "approve-leave", "free", "mktask", "ready", "amend", "done",
            "close", "reopen", "cancel", "record", "pr-move"}


def check_format():
    """Refuse records this ptt would misread rather than silently ignore them."""
    old = [d for place in PLACES for d in sorted((TASKS / place).glob("[0-9]*-*"))
           if d.is_dir()]
    need(not old, f"{old[0].relative_to(REC) if old else ''}: a task directory in an earlier "
         "Partitur format (no T prefix); rename each to T<number>-<slug> and write its "
         "`depends:` as T IDs, then record the change")
    roles = [e for e in (ROLES / "designer").glob("[0-9][0-9][0-9][0-9]-*.md")]
    need(not roles, "roles/designer/ holds designer role records of an earlier Partitur "
         "format; the designer is now the holder of task T0000. Move them out of the "
         "records' tasks and roles (for example to an archive directory), then record the "
         "change")
    need(any(n == ROOT for _, n, _ in all_tasks()),
         f"the root design task T{ROOT} (tasks/open/T{ROOT}-design/) is missing; "
         "run Partitur's install for this project")


def main():
    if sys.argv[1:2] == ["inbox"] and "--quiet" in sys.argv:
        try:                      # a prompt hook: never fail, never print an error
            sys.stderr = open(os.devnull, "w")
            run_main()
        except BaseException:
            pass
        sys.exit(0)
    run_main()


def run_main():
    global ACTOR
    ap = argparse.ArgumentParser(prog="ptt", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, *positional, as_=False, **options):
        p = sub.add_parser(name)
        for x in positional:
            p.add_argument(x)
        if as_:
            p.add_argument("--as", dest="as_", required=True)
        for opt, kw in options.items():
            p.add_argument("--" + opt, **kw)
        return p
    add("who")
    add("whoami")
    sub.choices["whoami"].add_argument("name", nargs="?")
    add("tasks", all=dict(action="store_true"))
    add("inbox", quiet=dict(action="store_true"), hook=dict(action="store_true"))
    add("unlock", force=dict(action="store_true"))
    add("handover", "name")
    sub.choices["inbox"].add_argument("name", nargs="?")
    add("show", "task")
    add("take", "what")
    add("resume")
    sub.choices["resume"].add_argument("name", nargs="?")
    add("leave", "name", status=dict())
    add("approve-leave", "task", as_=True)
    add("free", "what", as_=True, reason=dict(required=True), force=dict(action="store_true"))
    add("mktask", "slug", as_=True, kind=dict(default="track"), depends=dict())
    add("ready", "task", as_=True)
    add("amend", "task", as_=True, text=dict(required=True), depends=dict())
    add("done", "task", as_=True, requests=dict(), text=dict())
    add("close", "task", as_=True)
    add("reopen", "task", as_=True, reason=dict(required=True))
    add("cancel", "task", as_=True, reason=dict(required=True))
    p = sub.add_parser("pr-move")
    p.add_argument("request")
    p.add_argument("to", choices=("merged", "closed"))
    p.add_argument("-m", "--message", required=True)
    p.add_argument("--as", dest="as_", help="the writer's holder name, added to the message")
    p = sub.add_parser("record")
    p.add_argument("-m", "--message", required=True)
    p.add_argument("--as", dest="as_", help="the writer's holder name, added to the message")
    p.add_argument("paths", nargs="+")
    a = ap.parse_args()
    if a.cmd == "inbox" and a.hook:
        sid = read_hook_session()
        os.environ["PTT_SESSION_ID"] = os.environ.get("PTT_SESSION_ID") or sid
    if a.cmd in ("record", "pr-move") and a.as_:
        a.message += f" (by {a.as_})"
    need((REC / ".git").exists(), f"{REC} is not the records repository (no .git)")
    own = subprocess.run(["git", "-C", str(REC), "rev-parse", "--absolute-git-dir"],
                         capture_output=True, text=True).stdout.strip()
    need(Path(own).resolve() == git_dir(), "ptt runs only in the primary checkout of the "
         "records repository, not in a linked worktree: all sessions must share one state")
    check_format()
    run = globals()["cmd_" + a.cmd.replace("-", "_")]
    if a.cmd in MUTATING:
        with lock():
            actor = a.name if a.cmd in ("leave", "resume") else getattr(a, "as_", None)
            if a.cmd not in ("take", "resume"):
                check_session(None if actor == "user" else actor)
            ACTOR = actor or bound_here()
            run(a)
    else:
        run(a)


if __name__ == "__main__":
    main()
