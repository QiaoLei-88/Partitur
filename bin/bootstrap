#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
    printf '%s\n' 'usage: bootstrap TAG --scope project|user [install options]' >&2
    exit 2
fi
version=$1
shift

seed=$(mktemp -d "${TMPDIR:-/tmp}/partitur-bootstrap.XXXXXX")
trap 'rm -rf -- "$seed"' 0
trap 'exit 1' HUP INT TERM

git init -q -b master "$seed"
git -C "$seed" fetch -q --depth 1 --no-tags https://github.com/QiaoLei-88/Partitur \
    "refs/tags/$version:refs/tags/$version"
git -C "$seed" checkout -q --detach "refs/tags/$version"
python3 "$seed/bin/install" --release "$version" "$@"
