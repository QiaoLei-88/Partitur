#!/usr/bin/env python3
"""Create a run record directory for a checkout (Partitur, flows/evidence.md).

Usage:
  test-run new REPO_PATH [--root DIR]

Creates <root>/<id>/ with id = <UTC timestamp>-<short commit SHA>, for example
20261009T061500Z-7099ba2, writes run.md with the checkout's identity, and
prints the directory path. The caller puts the command, logs, outputs, exit
status and counts there; large outputs are recorded by SHA-256, size, and a
compact numerical summary. A run directory is written by one run and never
reused. The default root is test-runs/ in the workspace root (the parent of
the records repository holding this tool's directory).
"""
import argparse
import subprocess
import sys
import time
from pathlib import Path


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], check=True,
                          capture_output=True, text=True).stdout.strip()


def main():
    ap = argparse.ArgumentParser(prog="test-run", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("new")
    p.add_argument("repo", type=Path)
    p.add_argument("--root", type=Path,
                    default=Path(__file__).resolve().parent.parent.parent / "test-runs")
    a = ap.parse_args()

    try:
        sha = git(a.repo, "rev-parse", "HEAD")
        branch = git(a.repo, "branch", "--show-current") or "(detached)"
        dirty = git(a.repo, "status", "--porcelain")
        top = git(a.repo, "rev-parse", "--show-toplevel")
    except subprocess.CalledProcessError as e:
        sys.exit(f"test-run: {a.repo} is not a usable Git checkout: {e.stderr.strip()}")

    a.root.mkdir(parents=True, exist_ok=True)
    for _ in range(5):
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        run = a.root / f"{stamp}-{sha[:7]}"
        try:
            run.mkdir()
            break
        except FileExistsError:
            time.sleep(1)
    else:
        sys.exit("test-run: could not allocate a unique run id")

    (run / "run.md").write_text(
        "---\n"
        f"id: {run.name}\n"
        f"created: {stamp}\n"
        f"checkout: {top}\n"
        f"branch: {branch}\n"
        f"commit: {sha}\n"
        f"worktree_clean: {'no' if dirty else 'yes'}\n"
        "---\n\n"
        "# Test run\n\n"
        "## Purpose\n\n## Commands\n\n## Environment\n\n"
        "## Results\nExit status and passed/failed/skipped counts.\n\n"
        "## Files\nSmall files (logs, reports, diagnostic tables), kept in full.\n\n"
        "## Large outputs\n"
        "Not kept once the run is no longer needed for a pending decision; record\n"
        "each with its hash and a compact numerical summary for tolerance-based\n"
        "comparison.\n\n"
        "| File | SHA-256 | Bytes | Summary |\n"
        "| --- | --- | --- | --- |\n"
    )
    print(run)


if __name__ == "__main__":
    main()
